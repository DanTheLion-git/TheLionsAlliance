---
// Shared layout for the personal surfaces: /resume/, /resume/projects/*, /blog/*.
// Uses the tla- design system from homepage.css so these pages match the studio
// site. English-only by design (see Website/CLAUDE.md), so no NL toggle here.
import "../styles/homepage.css";
import "../styles/resume.css";

interface Props {
  title?: string;
  description?: string;
  /** true: the page lays out its own full-width sections (resume.astro).
   *  false: content is wrapped in a padded reading container. */
  wide?: boolean;
  /** Legacy prop from the old dark/light layout — accepted and ignored. */
  theme?: string;
}

const {
  title = "The Lions Alliance",
  description = "Daniël van Leeuwen — creative technologist and founder of The Lions Alliance.",
  wide = false,
} = Astro.props;
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon-logo.png" />
  </head>
  <body class="tla-page">

    <!-- ── Navigation ─────────────────────────────────── -->
    <nav class="tla-nav" id="tla-nav">
      <div class="tla-nav__inner">
        <a href="/" class="tla-nav__logo"><img src="/images/branding/lions-logo.webp" alt="" class="tla-nav__logo-img" />The Lions <span>Alliance</span></a>
        <ul class="tla-nav__links">
          <li><a href="/">Studio</a></li>
          <li><a href="/resume/#experience">Experience</a></li>
          <li><a href="/resume/#earlier-work">Earlier work</a></li>
          <li><a href="/blog/">Blog</a></li>
        </ul>
        <div class="tla-nav__actions">
          <a href="/contact/" class="tla-nav__cta tla-nav__cta--gold">Contact</a>
        </div>
        <button class="tla-nav__hamburger" id="tla-hamburger" aria-label="Menu">
          <span></span><span></span><span></span>
        </button>
      </div>
      <div class="tla-nav__mobile" id="tla-mobile-menu">
        <a href="/">Studio</a>
        <a href="/resume/#experience">Experience</a>
        <a href="/resume/#earlier-work">Earlier work</a>
        <a href="/blog/">Blog</a>
        <a href="/contact/">Contact</a>
      </div>
    </nav>

    <main class="cv-main">
      {wide ? <slot /> : <div class="tla-container cv-page"><slot /></div>}
    </main>

    <!-- ── Footer ─────────────────────────────────────── -->
    <footer class="tla-footer">
      <div class="tla-container">
        <div class="tla-footer__inner">
          <div class="tla-footer__brand">
            <div class="tla-footer__brand-row">
              <img src="/images/branding/lions-logo.webp" alt="" class="tla-footer__logo-img" />
              <span class="tla-footer__logo">The Lions <span>Alliance</span></span>
            </div>
            <span class="tla-footer__tagline">A Creative Experience Studio</span>
          </div>
          <nav class="tla-footer__links">
            <a href="/">Studio</a>
            <a href="/touchscreens/">Touch Station</a>
            <a href="/jan-truijen/">Brief aan Jan Truijen</a>
            <a href="/puzzlequests/">Puzzle Quests</a>
            <a href="/resume/">Resume</a>
            <a href="/blog/">Blog</a>
            <a href="/contact/">Contact</a>
          </nav>
        </div>
        <p class="tla-footer__copy">&copy; {year} The Lions Alliance. All rights reserved.</p>
      </div>
    </footer>

    <slot name="body-end" />

    <script>
      // Scroll-aware nav
      const nav = document.getElementById('tla-nav');
      window.addEventListener('scroll', () => {
        nav?.classList.toggle('scrolled', window.scrollY > 40);
      }, { passive: true });

      // Hamburger toggle
      const hamburger = document.getElementById('tla-hamburger');
      const mobileMenu = document.getElementById('tla-mobile-menu');
      hamburger?.addEventListener('click', () => {
        hamburger.classList.toggle('active');
        mobileMenu?.classList.toggle('open');
      });
      mobileMenu?.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          hamburger?.classList.remove('active');
          mobileMenu.classList.remove('open');
        });
      });

      // Fade-in on scroll
      const fadeObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('tla-visible');
            fadeObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
      document.querySelectorAll('.tla-fade').forEach(el => fadeObserver.observe(el));

      // "Download CV" buttons open the print dialog (print stylesheet in resume.css)
      document.querySelectorAll('[data-print]').forEach(btn => {
        btn.addEventListener('click', (e) => { e.preventDefault(); window.print(); });
      });
    </script>
  </body>
</html>
