---
import Layout from "../layouts/ResumeLayout.astro";
import { getPosts, type WPPost } from "../lib/wp";
import { decodeHTML } from "../lib/html";
const posts: WPPost[] = await getPosts(3);

const LINKEDIN = "https://www.linkedin.com/in/dani%C3%ABl-van-leeuwen-235675100/";

// ── Experience ───────────────────────────────────────────────
const EXPERIENCE = [
  {
    role:  "Founder & Creative Technologist",
    org:   "The Lions Alliance",
    dates: "May 2026 – present",
    desc:  "Founded a studio that builds storytelling technology for smaller, independent museums and heritage venues. Designed and built the Medelotapps touch-kiosk platform, now live on a touch table and classroom board at Museum Medelo; the Brief aan Jan Truijen talking-portrait installation; and the Skeleton Key walking-quest prop. Also runs WeddingCamBox and ShutterShare, two self-service event-photo products.",
  },
  {
    role:  "Software Developer",
    org:   "Pebble",
    dates: "Feb 2026 – Apr 2026",
    desc:  "Enterprise data engineering for ASML: built an ASP.NET / C# web application on Azure that streamlines how data-retention policies are set up across their data storage.",
  },
  {
    role:  "3D Animation & Video Developer",
    org:   "Enversed Studios",
    dates: "Dec 2023 – Feb 2026",
    desc:  "Took VRVoyage — a 70-minute 360° VR canal-boat journey through Golden Age Amsterdam, now a live tourist attraction — to completion as a near one-person production: modelling, procedural crowds in Geometry Nodes, Xsens motion capture and rendering. Also produced the Oosterschelde underwater VR binoculars, an on-site greenscreen 360° recruitment tour for Schiphol, animated dialogue panels for a children's discovery trail through a historic church in Zwolle, isometric game boards for two serious games, and product visualisations for Martens Beton and Lucardi.",
  },
  {
    role:  "Graduation Intern",
    org:   "Het Nieuwe Kader",
    dates: "Jan 2023 – Jul 2023",
    desc:  "Built a web-based automatic rigging tool (Python, Flask, MayaPy) that prepares characters for remote motion-capture sessions.",
  },
  {
    role:  "Intern Product Specialist",
    org:   "Movella / Xsens",
    dates: "Mar 2022 – Aug 2022",
    desc:  "Wrote documentation, gave customer demos and provided technical support for the Xsens MVN Animate motion-capture platform.",
  },
  {
    role:  "Junior VR Developer",
    org:   "Wired Workers",
    dates: "Jul 2020 – Aug 2021",
    desc:  "Built a Unity WebGL virtual showroom for collaborative robots, alongside my studies, including the product models, animations and more than fifty iterative web builds.",
  },
];

// ── Skills ───────────────────────────────────────────────────
const SKILLS = [
  {
    group: "3D, Animation & Video",
    items: ["Blender (Geometry Nodes)", "After Effects", "Xsens motion capture", "Reallusion", "Unreal Engine", "Unity", "360° VR video", "Greenscreen & on-site recording"],
  },
  {
    group: "Software",
    items: ["C# / WPF / WebView2", "ASP.NET", "Azure", "Python", "TypeScript / JavaScript", "Three.js / WebGL", "Astro", "SvelteKit", "Next.js", "Electron", "Node.js / Express", "PostgreSQL", "Docker"],
  },
  {
    group: "AI & Media Pipelines",
    items: ["Local LLMs (Ollama)", "RAG", "Piper TTS", "Rhubarb lip-sync", "ComfyUI (Flux, WAN video)"],
  },
  {
    group: "Hardware & Fabrication",
    items: ["ESP32 (ESP-NOW)", "Arduino", "Teensy", "Raspberry Pi", "NFC", "Soldering & custom electronics", "Laser cutting", "Resin 3D printing"],
  },
];

// ── Earlier work: client & student projects before the studio ──
// thumb: local image; youtube: video ID used for the thumbnail; neither shows a text placeholder.
type Earlier = { title: string; meta: string; desc: string; page: string; thumb?: string; youtube?: string };

const CLIENT_WORK: Earlier[] = [
  {
    title:   "VRVoyage",
    meta:    "Enversed Studios · 360° VR",
    youtube: "sfveQ_2cajM",
    desc:    "70-minute 360° VR journey aboard a canal boat through Golden Age Amsterdam, with motion-captured characters and procedural crowds.",
    page:    "/resume/projects/amsterdam-rederij/",
  },
  {
    title:   "Academiehuis Zwolle",
    meta:    "Enversed Studios · Motion design",
    thumb:   "/images/projects/academiehuis/thumb.webp",
    desc:    "Animated dialogue panels, route maps and year countdowns for a children's discovery trail through a historic church.",
    page:    "/resume/projects/academiehuis/",
  },
  {
    title:   "Virtual Showroom",
    meta:    "Wired Workers · Unity WebGL · playable",
    thumb:   "/images/projects/wired-workers/thumb.webp",
    desc:    "Browser-based 3D showroom for collaborative robots, with product models built for the job. Playable on the page.",
    page:    "/resume/projects/wired-workers-showroom/",
  },
  {
    title:   "Isometric Game Boards",
    meta:    "Enversed Studios · Blender",
    thumb:   "/images/projects/isometric-game-boards/thumb.webp",
    desc:    "Cut-away isometric buildings rendered as the playing field for two serious games.",
    page:    "/resume/projects/isometric-game-boards/",
  },
  {
    title:   "Oosterschelde VR",
    meta:    "Enversed Studios · 360° VR",
    youtube: "VprojdpSWek",
    desc:    "360° underwater VR film in public binoculars on the Oosterschelde dike, bringing the seabed to non-divers.",
    page:    "/resume/projects/oosterschelde/",
  },
  {
    title:   "Werken bij Schiphol",
    meta:    "Enversed Studios · 360° tour",
    desc:    "Interactive 360° career-orientation tour with on-site greenscreen interviews at Schiphol Airport.",
    page:    "/resume/projects/werken-bij-schiphol/",
  },
  {
    title:   "Martens Beton",
    meta:    "Enversed Studios · Blender",
    youtube: "AVFDtIFl_yc",
    desc:    "Animated product video for a rolling-ring sewer-pipe system.",
    page:    "/resume/projects/martens-beton/",
  },
  {
    title:   "Lucardi",
    meta:    "Enversed Studios · Blender",
    youtube: "bbm4KqhNv1E",
    desc:    "Photorealistic 3D jewellery showcase with diamond refraction.",
    page:    "/resume/projects/lucardi/",
  },
];

const STUDIES: Earlier[] = [
  {
    title:   "Python Autorigger",
    meta:    "Graduation project · 2023",
    youtube: "zupK9LBxZwk",
    desc:    "Web-based automatic rigging tool for remote motion-capture sessions.",
    page:    "/resume/projects/python-autorigger/",
  },
  {
    title:   "Medusa",
    meta:    "Music-video VFX · 2024",
    thumb:   "/images/projects/medusa/thumb.webp",
    desc:    "Animated snake hair for the music video \"Tiara\" by Manuel.",
    page:    "/resume/projects/medusa/",
  },
  {
    title:   "Boss Challenge",
    meta:    "Unreal Engine · 2023",
    thumb:   "/images/projects/boss-challenge/thumb.webp",
    desc:    "Real-time cinematic test of a pirate harbour town.",
    page:    "/resume/projects/boss-challenge/",
  },
  {
    title:   "Houdini FX Study",
    meta:    "Houdini · 2022",
    thumb:   "/images/projects/houdini-fx/thumb.webp",
    desc:    "Energy, spark and simulation effects for a creature battle.",
    page:    "/resume/projects/houdini-fx/",
  },
  {
    title:   "Garbage Gary",
    meta:    "Student project · Saxion",
    youtube: "Nn0hLqFrPOk",
    desc:    "Touch-screen educational game for the Oyfo technology museum.",
    page:    "/resume/projects/garbage-gary/",
  },
];

const thumbOf = (p: Earlier) =>
  p.thumb ?? (p.youtube ? `https://img.youtube.com/vi/${p.youtube}/hqdefault.jpg` : null);
---

<Layout
  title="Daniël van Leeuwen — CV"
  description="CV of Daniël van Leeuwen — creative technologist and founder of The Lions Alliance, building storytelling technology for museums and heritage venues."
  wide
>

  <!-- ── Hero ───────────────────────────────────────── -->
  <section class="tla-hero cv-hero">
    <img src="/images/branding/lions-mark.svg" alt="" class="tla-hero__watermark" aria-hidden="true" />
    <div class="tla-container">
      <p class="tla-hero__eyebrow">Curriculum Vitae</p>
      <h1 class="tla-hero__title">Daniël <em>van Leeuwen</em></h1>
      <p class="tla-hero__subtitle">Creative technologist and founder of The Lions Alliance. I build storytelling technology for museums and heritage venues &mdash; from 3D and VR to kiosk software, local AI and hand-built electronics.</p>
      <div class="tla-hero__actions cv-hero__actions">
        <a href="#" class="tla-btn tla-btn--primary" data-print>Download CV</a>
        <a href={LINKEDIN} class="tla-btn tla-btn--outline" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="/contact/" class="tla-btn tla-btn--outline">Contact</a>
      </div>
      <p class="cv-socials">
        <a href="https://www.youtube.com/@DanTheLionVFX" target="_blank" rel="noopener noreferrer">YouTube</a>
        <span aria-hidden="true">&middot;</span>
        <a href="https://sketchfab.com/superwortel" target="_blank" rel="noopener noreferrer">Sketchfab</a>
        <span aria-hidden="true">&middot;</span>
        <a href="https://daanvanleeuwen.itch.io" target="_blank" rel="noopener noreferrer">Itch.io</a>
      </p>
      <p class="cv-print-only cv-print-contact">info.mvdvl@gmail.com &middot; linkedin.com/in/daniël-van-leeuwen-235675100 &middot; thelionsalliance.com &middot; The Netherlands</p>
    </div>
  </section>

  <!-- ── Profile ────────────────────────────────────── -->
  <section class="tla-studio" id="profile">
    <div class="tla-container">
      <div class="tla-studio__grid">
        <div class="tla-studio__text tla-fade">
          <span class="tla-overline">Profile</span>
          <h2>Story first, technology second</h2>
          <p>I like to work end to end. On one project that can mean modelling a historical street, writing the kiosk software that shows it, and soldering the hardware a visitor holds in their hand. Today I put that into The Lions Alliance, a studio I run with Thirza van Leeuwen, building touch tables, talking portraits and walking quests for smaller, independent museums.</p>
          <p style="margin-top:1rem;">Before the studio I spent two years making immersive VR, 360° video and product visualisations at Enversed Studios, and worked as a software developer on enterprise data at Pebble.</p>
        </div>
        <div class="tla-studio__phases tla-fade tla-d2">
          <div class="tla-phase-item">
            <span class="tla-phase-item__num">01</span>
            <div>
              <p class="tla-phase-item__label">Now</p>
              <p class="tla-phase-item__name">Founder, The Lions Alliance</p>
            </div>
          </div>
          <div class="tla-phase-item">
            <span class="tla-phase-item__num">02</span>
            <div>
              <p class="tla-phase-item__label">Before</p>
              <p class="tla-phase-item__name">3D &amp; VR at Enversed Studios</p>
            </div>
          </div>
          <div class="tla-phase-item">
            <span class="tla-phase-item__num">03</span>
            <div>
              <p class="tla-phase-item__label">Education</p>
              <p class="tla-phase-item__name">BSc Creative Media &amp; Game Technologies, Saxion</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Now: The Lions Alliance ────────────────────── -->
  <section class="tla-pillars cv-now" id="now">
    <div class="tla-container">
      <div class="tla-section-header tla-fade">
        <span class="tla-overline">Now</span>
        <h2>Building The Lions Alliance</h2>
        <div class="tla-divider"></div>
      </div>
    </div>
    <div class="tla-pillars__grid-wrap">
      <div class="tla-pillars__grid cv-now__grid">
        <div class="tla-pillar-card tla-fade tla-d1">
          <img src="/images/touch-tafel/IMG20260920161431.webp" alt="A Medelotapps touch table running at Museum Medelo in Meijel" loading="lazy" class="cv-now__img" />
          <div class="tla-pillar-card__head">
            <span class="tla-badge tla-badge--live">Live at Museum Medelo</span>
          </div>
          <h3>Medelotapps &amp; Touch Tables</h3>
          <p class="tla-pillar-card__tagline">Kiosk software &middot; Custom touch tables</p>
          <p class="tla-pillar-card__desc">A touch-kiosk platform running on a touch table and a classroom board at Museum Medelo since its opening on 20 September 2026. The content inside is built for each venue.</p>
          <p class="tla-pillar-card__project"><strong>My role:</strong> platform architecture and development (C#, WPF, WebView2), content tooling, hardware set-up.</p>
          <a href="/touchscreens/" class="tla-btn tla-btn--outline tla-btn--sm">See Touch Station</a>
        </div>
        <div class="tla-pillar-card tla-fade tla-d2">
          <img src="/images/brief-aan-jan/prototype-20-09-2026/IMG20260920135209.webp" alt="The Brief aan Jan Truijen talking-portrait installation, with typewriter and antique desk" loading="lazy" class="cv-now__img" />
          <div class="tla-pillar-card__head">
            <span class="tla-badge tla-badge--dev">Working prototype</span>
          </div>
          <h3>Brief aan Jan Truijen</h3>
          <p class="tla-pillar-card__tagline">Talking portrait &middot; AI voice &amp; 3D animation</p>
          <p class="tla-pillar-card__desc">Visitors write a letter on a converted antique typewriter, and a historical portrait answers in character. Shown live at Museum Medelo's opening and built to travel to new venues.</p>
          <p class="tla-pillar-card__project"><strong>My role:</strong> concept and full build: local LLM with RAG, Piper TTS, Rhubarb lip-sync, three.js head, typewriter-to-USB electronics.</p>
          <a href="/jan-truijen/" class="tla-btn tla-btn--outline tla-btn--sm">See the installation</a>
        </div>
        <div class="tla-pillar-card tla-fade tla-d3">
          <img src="/images/puzzle-quests/skeleton-key-wip/IMG20260901145952.webp" alt="The hand-built Skeleton Key prop, a lion's-head brass key" loading="lazy" class="cv-now__img" />
          <div class="tla-pillar-card__head">
            <span class="tla-badge tla-badge--dev">In build &amp; testing</span>
          </div>
          <h3>Puzzle Quests &mdash; Skeleton Key</h3>
          <p class="tla-pillar-card__tagline">Walking route &middot; Physical prop</p>
          <p class="tla-pillar-card__desc">A 5 km walking quest through Meijel, carried by a hand-built brass key that senses eight hidden lock-stations. No app, no screen.</p>
          <p class="tla-pillar-card__project"><strong>My role:</strong> story and route design, embedded electronics, firmware, 3D-printed and laser-cut prop.</p>
          <a href="/puzzlequests/" class="tla-btn tla-btn--outline tla-btn--sm">See Puzzle Quests</a>
        </div>
      </div>
    </div>
    <div class="tla-container">
      <p class="cv-also tla-fade">Also running: <a href="https://weddingcambox.nl" target="_blank" rel="noopener">WeddingCamBox</a> and <a href="https://shuttershare.nl" target="_blank" rel="noopener">ShutterShare</a>, self-service event-photo products with their own booking, gallery and mail backend.</p>
    </div>
  </section>

  <!-- ── Experience ─────────────────────────────────── -->
  <section class="cv-section cv-section--white" id="experience">
    <div class="tla-container">
      <div class="tla-section-header tla-fade">
        <span class="tla-overline">Career</span>
        <h2>Experience</h2>
        <div class="tla-divider"></div>
      </div>
      <ol class="cv-list">
        {EXPERIENCE.map((e) => (
          <li class="cv-entry tla-fade">
            <p class="cv-entry__dates">{e.dates}</p>
            <div>
              <h3 class="cv-entry__role">{e.role}</h3>
              <p class="cv-entry__org">{e.org}</p>
              <p class="cv-entry__desc">{e.desc}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ── Education & Skills ─────────────────────────── -->
  <section class="cv-section" id="education">
    <div class="tla-container">
      <div class="tla-section-header tla-fade">
        <span class="tla-overline">Education</span>
        <h2>Education &amp; skills</h2>
        <div class="tla-divider"></div>
      </div>
      <ol class="cv-list">
        <li class="cv-entry tla-fade">
          <p class="cv-entry__dates">Aug 2018 – Jul 2023</p>
          <div>
            <h3 class="cv-entry__role">BSc Creative Media &amp; Game Technologies</h3>
            <p class="cv-entry__org">Saxion University of Applied Sciences</p>
          </div>
        </li>
      </ol>
      <div class="cv-skills">
        {SKILLS.map((s) => (
          <div class="tla-value-card tla-fade">
            <h3>{s.group}</h3>
            <ul class="cv-chips">
              {s.items.map((i) => <li>{i}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ── Earlier work ───────────────────────────────── -->
  <section class="cv-section cv-section--alt cv-earlier" id="earlier-work">
    <div class="tla-container">
      <div class="tla-section-header tla-fade">
        <span class="tla-overline">Archive</span>
        <h2>Earlier work</h2>
        <p>Client and student projects from before the studio.</p>
        <div class="tla-divider"></div>
      </div>
      <h3 class="cv-earlier__group">Client work</h3>
      <ul class="cv-earlier__grid">
        {CLIENT_WORK.map((p) => (
          <li class="cv-earlier__card tla-fade">
            <a href={p.page} class="cv-earlier__link">
              {thumbOf(p)
                ? <img src={thumbOf(p)} alt="" loading="lazy" class="cv-earlier__thumb" />
                : <div class="cv-earlier__thumb cv-earlier__thumb--empty"><span>{p.title}</span></div>}
              <div class="cv-earlier__body">
                <h3>{p.title}</h3>
                <p class="cv-earlier__meta">{p.meta}</p>
                <p class="cv-earlier__desc">{p.desc}</p>
                <span class="cv-earlier__more">Learn more &rarr;</span>
              </div>
            </a>
          </li>
        ))}
      </ul>

      <h3 class="cv-earlier__group cv-earlier__group--small">Studies &amp; side projects</h3>
      <ul class="cv-earlier__grid cv-earlier__grid--small">
        {STUDIES.map((p) => (
          <li class="cv-earlier__card cv-earlier__card--small tla-fade">
            <a href={p.page} class="cv-earlier__link">
              {thumbOf(p)
                ? <img src={thumbOf(p)} alt="" loading="lazy" class="cv-earlier__thumb" />
                : <div class="cv-earlier__thumb cv-earlier__thumb--empty"><span>{p.title}</span></div>}
              <div class="cv-earlier__body">
                <h3>{p.title}</h3>
                <p class="cv-earlier__meta">{p.meta}</p>
                <p class="cv-earlier__desc">{p.desc}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ── From the blog ──────────────────────────────── -->
  {posts.length > 0 && (
    <section class="cv-section cv-section--white cv-blog" id="writing">
      <div class="tla-container">
        <div class="tla-section-header tla-fade">
          <span class="tla-overline">Writing</span>
          <h2>From the blog</h2>
          <div class="tla-divider"></div>
        </div>
        <ul class="cv-blog__grid">
          {posts.map((post) => (
            <li class="tla-value-card tla-fade">
              <a href={`/blog/${post.slug}/`} class="cv-blog__link">
                <p class="cv-blog__date">
                  <time datetime={post.date}>
                    {new Date(post.date).toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "2-digit" })}
                  </time>
                </p>
                <h3>{decodeHTML(post.title.rendered)}</h3>
                <div class="cv-blog__excerpt" set:html={post.excerpt.rendered} />
              </a>
            </li>
          ))}
        </ul>
        <p class="cv-blog__all"><a href="/blog/" class="tla-btn tla-btn--outline tla-btn--sm">All posts</a></p>
      </div>
    </section>
  )}

  <!-- ── Contact ────────────────────────────────────── -->
  <section class="tla-contact" id="contact">
    <div class="tla-container">
      <span class="tla-overline tla-fade">Get in touch</span>
      <h2 class="tla-fade tla-d1">Let&rsquo;s work together</h2>
      <p class="tla-fade tla-d2">Interested in working together, on a museum project or otherwise? I&rsquo;d like to hear from you.</p>
      <div class="tla-contact__actions tla-fade tla-d3">
        <a href="/contact/" class="tla-btn tla-btn--gold">Send a message</a>
        <a href={LINKEDIN} class="tla-btn tla-btn--ghost" target="_blank" rel="noopener noreferrer">Connect on LinkedIn</a>
      </div>
      <p class="tla-contact__email tla-fade tla-d3"><a href="mailto:info.mvdvl@gmail.com">info.mvdvl@gmail.com</a></p>
    </div>
  </section>

</Layout>
