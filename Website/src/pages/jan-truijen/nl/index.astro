---
import "../../../styles/homepage.css";
import "../../../styles/puzzlequests.css";
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Brief aan Jan Truijen &mdash; The Lions Alliance</title>
    <meta name="description" content="Brief aan Jan Truijen is een sprekend-portret-installatie voor musea en erfgoedlocaties — bezoekers schrijven een brief op een omgebouwde antieke typemachine, en een historische figuur schrijft terug in karakter, met een AI-stem en 3D-gezichtsanimatie." />
    <link rel="icon" type="image/png" href="/favicon-logo.png" />
    <link rel="alternate" hreflang="en" href="https://thelionsalliance.com/jan-truijen/" />
    <link rel="alternate" hreflang="nl" href="https://thelionsalliance.com/jan-truijen/nl/" />
    <link rel="alternate" hreflang="x-default" href="https://thelionsalliance.com/jan-truijen/" />
  </head>
  <body class="tla-page pl-body">

    <!-- ── Navigatie ──────────────────────────────────── -->
    <nav class="tla-nav" id="tla-nav">
      <div class="tla-nav__inner tla-container">
        <a href="/nl/" class="tla-nav__logo"><img src="/images/branding/lions-logo.webp" alt="" class="tla-nav__logo-img" />The Lions <span>Alliance</span></a>
        <ul class="tla-nav__links">
          <li><a href="#overview">Overzicht</a></li>
          <li><a href="#how-it-works">Hoe het werkt</a></li>
          <li><a href="#adapt">Voor uw locatie</a></li>
        </ul>
        <div class="tla-nav__actions">
          <a href="/jan-truijen/" class="tla-nav__lang" hreflang="en" lang="en" title="View in English">EN</a>
          <a href="/contact/nl/" class="tla-nav__cta tla-nav__cta--gold">Contact</a>
          <a href="/nl/" class="tla-nav__cta">&larr; Studio</a>
        </div>
        <button class="tla-nav__hamburger" id="hamburger" aria-label="Menu openen">
          <span></span><span></span><span></span>
        </button>
      </div>
      <div class="tla-nav__mobile" id="mobile-menu">
        <a href="#overview">Overzicht</a>
        <a href="#how-it-works">Hoe het werkt</a>
        <a href="#adapt">Voor uw locatie</a>
        <a href="/contact/nl/">Contact</a>
        <a href="/jan-truijen/" hreflang="en" lang="en">View in English</a>
        <a href="/nl/">&larr; Terug naar de studio</a>
      </div>
    </nav>

    <!-- ── Hero ───────────────────────────────────────── -->
    <section class="pl-hero" id="home">
      <div class="tla-container pl-hero__inner">
        <div class="pl-hero__text tla-fade">
          <div class="pl-hero__breadcrumb">
            <a href="/nl/">The Lions Alliance</a>
            <span class="pl-hero__breadcrumb-sep">/</span>
            <span>Brief aan Jan Truijen</span>
          </div>
          <div class="pl-hero__badges">
            <span class="tla-badge tla-badge--dev">Werkend prototype</span>
            <span class="tla-badge tla-badge--live">Live getoond &mdash; 20 sept 2026</span>
          </div>
          <h1 class="pl-hero__title">Brief aan <em>Jan Truijen</em></h1>
          <p class="pl-hero__subtitle">
            Een sprekend-portret-installatie voor musea en erfgoedlocaties. Bezoekers schrijven een brief op een omgebouwde antieke typemachine &mdash; en een historische figuur schrijft terug, in karakter, met een AI-stem en 3D-gezichtsanimatie in real time.
          </p>
          <div class="pl-hero__ctas">
            <a href="#adapt" class="tla-btn tla-btn--sage">Breng dit naar uw locatie</a>
            <a href="/contact/nl/" class="tla-btn tla-btn--outline">Neem contact op</a>
          </div>
        </div>
        <div class="pl-hero__visual tla-fade tla-d1">
          <img src="/images/brief-aan-jan/prototype-20-09-2026/IMG20260920135157.webp" alt="De installatie Brief aan Jan Truijen draaiend bij Museum Medelo — antiek bureau, typemachine en het sprekende portret, met het kostuum van Jan Truijen ernaast" loading="eager" style="width:100%; border-radius:var(--tla-radius-xl); box-shadow:var(--tla-shadow-md);" />
        </div>
      </div>
    </section>

    <!-- ── Overzicht ────────────────────────────────────── -->
    <section class="pl-overview" id="overview">
      <div class="tla-container pl-overview__inner">
        <div class="pl-overview__text tla-fade">
          <span class="tla-overline">De installatie</span>
          <h2 class="tla-section-header pl-section-header--left">Een brief aan het verleden, beantwoord</h2>
          <p>
            Jan Truijen (1838&ndash;1919) was burgemeester, landmeter, gemeentesecretaris en Tweede Kamerlid van Meijel &mdash; een echte historische figuur wiens portret in Museum Medelo hangt. Bezoekers nemen plaats achter een omgebouwde antieke typemachine en schrijven hem een brief. Zodra de brief verstuurd is, komt het portret tot leven: een AI-stem en een driedimensionale gezichtsanimatie in real time lezen de brief voor en antwoorden in karakter &mdash; gegrond in het historisch archief, niet verzonnen, en eerlijk wanneer iets niet bekend is.
          </p>
          <p>
            Wij toonden het voor het eerst live aan het publiek tijdens de ledenopening van Museum Medelo op 20 september 2026 &mdash; een werkend prototype, nog geen permanente onbemande installatie. Medelo is het proof-of-concept; het format is ontworpen om te reizen.
          </p>
        </div>
        <div class="pl-overview__visual tla-fade tla-d1">
          <div style="width:100%; padding:1.5rem; background:rgba(0,0,0,0.04); border-radius:var(--tla-radius-md);">
            <strong style="font-size:0.85rem; letter-spacing:0.02em; text-transform:uppercase; color:var(--tla-gold,#c9aa71);">Van getypte brief tot gesproken antwoord</strong>
            <ol style="margin-top:0.9rem; display:flex; flex-direction:column; gap:0.65rem;">
              <li style="display:flex; gap:0.65rem; align-items:baseline; font-size:0.9rem; color:var(--tla-text-body); line-height:1.5;">
                <span style="font-family:'Cormorant Garamond',serif; font-weight:600; font-size:1.05rem; color:var(--tla-gold,#c9aa71); flex-shrink:0;">1</span>
                <span>De bezoeker typt een bericht op de typemachine</span>
              </li>
              <li style="display:flex; gap:0.65rem; align-items:baseline; font-size:0.9rem; color:var(--tla-text-body); line-height:1.5;">
                <span style="font-family:'Cormorant Garamond',serif; font-weight:600; font-size:1.05rem; color:var(--tla-gold,#c9aa71); flex-shrink:0;">2</span>
                <span>Het bericht wordt vergeleken met het archief van de figuur</span>
              </li>
              <li style="display:flex; gap:0.65rem; align-items:baseline; font-size:0.9rem; color:var(--tla-text-body); line-height:1.5;">
                <span style="font-family:'Cormorant Garamond',serif; font-weight:600; font-size:1.05rem; color:var(--tla-gold,#c9aa71); flex-shrink:0;">3</span>
                <span>Er wordt een antwoord opgesteld, gegrond in wat echt bekend is</span>
              </li>
              <li style="display:flex; gap:0.65rem; align-items:baseline; font-size:0.9rem; color:var(--tla-text-body); line-height:1.5;">
                <span style="font-family:'Cormorant Garamond',serif; font-weight:600; font-size:1.05rem; color:var(--tla-gold,#c9aa71); flex-shrink:0;">4</span>
                <span>Het antwoord wordt hardop uitgesproken met een AI-stem</span>
              </li>
              <li style="display:flex; gap:0.65rem; align-items:baseline; font-size:0.9rem; color:var(--tla-text-body); line-height:1.5;">
                <span style="font-family:'Cormorant Garamond',serif; font-weight:600; font-size:1.05rem; color:var(--tla-gold,#c9aa71); flex-shrink:0;">5</span>
                <span>Het gezicht van het portret beweegt synchroon mee, op het scherm</span>
              </li>
            </ol>
          </div>
        </div>
      </div>
    </section>

    <div class="tla-divider"></div>

    <!-- ── Hoe het werkt ──────────────────────────────── -->
    <section class="pl-steps-section" id="how-it-works">
      <div class="tla-container">
        <div class="tla-fade" style="text-align:center;">
          <span class="tla-overline">Hoe het werkt</span>
          <h2 class="tla-section-header">De bezoekerservaring, in drie stappen</h2>
        </div>
        <div class="pl-steps">
          <div class="pl-step tla-fade">
            <div class="pl-step__number">I</div>
            <div class="pl-step__title">Schrijf uw brief</div>
            <div class="pl-step__desc">De bezoeker neemt plaats aan het bureau en schrijft een brief aan de figuur op het portret, met een omgebouwde antieke typemachine. Geen scherm, geen toetsenbord.</div>
          </div>
          <div class="pl-step tla-fade tla-d1">
            <div class="pl-step__number">II</div>
            <div class="pl-step__title">Het portret ontwaakt</div>
            <div class="pl-step__desc">De brief wordt verstuurd, en het portret komt tot leven &mdash; een AI-stem en 3D-gezichtsanimatie in real time bereiden een antwoord voor, geput uit het historisch archief.</div>
          </div>
          <div class="pl-step tla-fade tla-d2">
            <div class="pl-step__number">III</div>
            <div class="pl-step__title">Een levend antwoord</div>
            <div class="pl-step__desc">De figuur antwoordt hardop, in karakter, met verwijzingen naar de echte geschiedenis. Weet hij iets niet, dan zegt hij dat ook &mdash; het moment blijft eerlijk, geen verzonnen fantasie.</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Voor uw locatie ────────────────────────────── -->
    <section class="pl-adapt" id="adapt">
      <div class="tla-container">
        <div class="tla-fade" style="text-align:center;">
          <span class="tla-overline">Voor uw locatie</span>
          <h2 class="tla-section-header">De techniek is herbruikbaar. Het portret is van u.</h2>
        </div>
        <div class="pl-adapt__grid">
          <div class="pl-adapt__col tla-fade">
            <h3 class="pl-adapt__title">Wat hetzelfde blijft</h3>
            <ul class="pl-adapt__list">
              <li>De opzet en het bezoekerstraject, van getypt bericht tot gesproken antwoord.</li>
              <li>De installatiehardware ter plekke.</li>
            </ul>
          </div>
          <div class="pl-adapt__col tla-fade tla-d1">
            <h3 class="pl-adapt__title">Wat wij per locatie ontwerpen</h3>
            <ul class="pl-adapt__list">
              <li>De historische figuur die tot leven komt.</li>
              <li>Het kennisarchief waar de figuur uit put.</li>
              <li>De invoermethode &mdash; dit hoeft geen typemachine te zijn.</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Samenwerking ───────────────────────────────── -->
    <section class="pl-collaborate" id="collaborate">
      <div class="tla-container pl-collaborate__inner">
        <div class="pl-collaborate__text tla-fade">
          <span class="tla-overline">Samenwerking</span>
          <h2 class="tla-section-header pl-section-header--left">Breng een sprekend portret naar uw locatie</h2>
          <p>
            Het sprekend-portret-format is herhaalbaar: een andere historische figuur, een andere locatie, dezelfde bewezen opzet. Heeft uw museum, erfgoedlocatie of historisch pand een portret en een archief dat tot leven verdient te komen, dan horen wij graag van u.
          </p>
          <div class="pl-collaborate__ctas">
            <a href="/contact/nl/" class="tla-btn tla-btn--gold">Neem contact op</a>
            <a href="/nl/" class="tla-btn tla-btn--outline">Bekijk de studio &rarr;</a>
          </div>
        </div>
        <div class="pl-collaborate__audiences tla-fade tla-d1">
          <ul class="pl-audience-list">
            <li class="pl-audience-item"><span class="pl-audience-dot"></span>Streek- en heemkundemusea</li>
            <li class="pl-audience-item"><span class="pl-audience-dot"></span>Heemkundeverenigingen &amp; archieven</li>
            <li class="pl-audience-item"><span class="pl-audience-dot"></span>Historische panden &amp; landgoederen</li>
            <li class="pl-audience-item"><span class="pl-audience-dot"></span>Toerisme-organisaties</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ── Footer ─────────────────────────────────────── -->
    <footer class="tla-footer">
      <div class="tla-container tla-footer__inner">
        <div class="tla-footer__brand">
          <div class="tla-footer__brand-row">
            <img src="/images/branding/lions-logo.webp" alt="" class="tla-footer__logo-img" />
            <div class="tla-footer__logo">The Lions Alliance</div>
          </div>
          <p class="tla-footer__tagline">Studio voor museale technologie &amp; erfgoed.</p>
        </div>
        <div class="tla-footer__links">
          <a href="/nl/">Studio</a>
          <a href="#overview">Overzicht</a>
          <a href="#adapt">Voor uw locatie</a>
          <a href="#collaborate">Samenwerking</a>
          <a href="/jan-truijen/" hreflang="en" lang="en">English version</a>
        </div>
      </div>
      <div class="tla-container tla-footer__bottom">
        <span>&copy; {year} The Lions Alliance. Alle rechten voorbehouden.</span>
      </div>
    </footer>

    <!-- ── Scripts ─────────────────────────────────────── -->
    <script>
      const nav = document.getElementById('tla-nav');
      if (nav) {
        window.addEventListener('scroll', () => {
          nav.classList.toggle('scrolled', window.scrollY > 40);
        });
      }
      const faders = document.querySelectorAll('.tla-fade');
      if (faders.length && 'IntersectionObserver' in window) {
        const obs = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('tla-visible');
                obs.unobserve(e.target);
              }
            });
          },
          { threshold: 0.15 }
        );
        faders.forEach((el) => obs.observe(el));
      } else {
        faders.forEach((el) => el.classList.add('tla-visible'));
      }
      const hamburger = document.getElementById('hamburger');
      const mobileMenu = document.getElementById('mobile-menu');
      if (hamburger && mobileMenu) {
        hamburger.addEventListener('click', () => {
          const open = mobileMenu.classList.toggle('open');
          hamburger.classList.toggle('open', open);
          hamburger.setAttribute('aria-expanded', String(open));
        });
        mobileMenu.querySelectorAll('a').forEach((a) => {
          a.addEventListener('click', () => {
            mobileMenu.classList.remove('open');
            hamburger.classList.remove('open');
            hamburger.setAttribute('aria-expanded', 'false');
          });
        });
      }
    </script>
  </body>
</html>
