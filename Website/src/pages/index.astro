---
import "../styles/homepage.css";
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>The Lions Alliance &mdash; Museum &amp; Heritage Storytelling Studio</title>
    <meta name="description" content="The Lions Alliance builds technology-driven storytelling for museums and heritage venues &mdash; touch tables, talking portraits, and walking quests, designed for smaller, independent locations." />
    <link rel="icon" type="image/png" href="/favicon-logo.png" />
    <link rel="alternate" hreflang="en" href="https://thelionsalliance.com/" />
    <link rel="alternate" hreflang="nl" href="https://thelionsalliance.com/nl/" />
    <link rel="alternate" hreflang="x-default" href="https://thelionsalliance.com/" />
  </head>
  <body class="tla-page">

    <!-- ── Navigation ─────────────────────────────────── -->
    <nav class="tla-nav" id="tla-nav">
      <div class="tla-nav__inner">
        <a href="/" class="tla-nav__logo"><img src="/images/branding/lions-logo.webp" alt="" class="tla-nav__logo-img" />The Lions <span>Alliance</span></a>
        <ul class="tla-nav__links">
          <li><a href="#studio">Studio</a></li>
          <li><a href="#pillars">Our Work</a></li>
          <li><a href="#roadmap">Roadmap</a></li>
        </ul>
        <div class="tla-nav__actions">
          <a href="/nl/" class="tla-nav__lang" hreflang="nl" lang="nl" title="Bekijk in het Nederlands">NL</a>
          <a href="/contact/" class="tla-nav__cta tla-nav__cta--gold">Contact</a>
        </div>
        <button class="tla-nav__hamburger" id="tla-hamburger" aria-label="Menu">
          <span></span><span></span><span></span>
        </button>
      </div>
      <div class="tla-nav__mobile" id="tla-mobile-menu">
        <a href="#studio">Studio</a>
        <a href="#pillars">Our Work</a>
        <a href="#roadmap">Roadmap</a>
        <a href="/contact/">Contact</a>
        <a href="/nl/" hreflang="nl" lang="nl">Bekijk in het Nederlands</a>
      </div>
    </nav>

    <!-- ── Hero ───────────────────────────────────────── -->
    <section class="tla-hero" id="hero">
      <img src="/images/branding/lions-mark.svg" alt="" class="tla-hero__watermark" aria-hidden="true" />
      <div class="tla-container">
        <div class="tla-fade">
          <p class="tla-hero__eyebrow">Museum &amp; Heritage Technology Studio</p>
        </div>
        <h1 class="tla-hero__title tla-fade tla-d1">We turn museum stories<br /><em>into experiences worth remembering.</em></h1>
        <p class="tla-hero__subtitle tla-fade tla-d2">We build the technology that lets smaller, independent museums and heritage venues tell their stories in new ways &mdash; touch tables, talking portraits, and walking quests, built for the venue, not the other way around.</p>
        <div class="tla-hero__actions tla-fade tla-d3">
          <a href="#pillars" class="tla-btn tla-btn--primary">Explore our work</a>
          <a href="#roadmap" class="tla-btn tla-btn--outline">See our roadmap</a>
        </div>
      </div>
    </section>

    <!-- ── Studio Statement ───────────────────────────── -->
    <section class="tla-studio" id="studio">
      <div class="tla-container">
        <div class="tla-studio__grid">
          <div class="tla-studio__text tla-fade">
            <span class="tla-overline">About the studio</span>
            <h2>Where technology meets the story</h2>
            <p>The Lions Alliance is a creative studio built around one specialism: giving museums and heritage venues the technology to tell their own stories, without a big corporate production budget. We build touch tables, talking-portrait installations, and physical walking quests &mdash; always designed around a specific place, a specific archive, a specific story.</p>
            <p style="margin-top:1rem;">The studio is built by <strong>Dani&euml;l</strong> and <strong>Thirza van Leeuwen</strong>.</p>
          </div>
          <div class="tla-studio__phases tla-fade tla-d2">
            <div class="tla-phase-item">
              <span class="tla-phase-item__num">01</span>
              <div>
                <p class="tla-phase-item__label">Built for</p>
                <p class="tla-phase-item__name">Smaller, independent museums &amp; heritage venues</p>
              </div>
            </div>
            <div class="tla-phase-item">
              <span class="tla-phase-item__num">02</span>
              <div>
                <p class="tla-phase-item__label">Powered by</p>
                <p class="tla-phase-item__name">Touchscreens, AI voice &amp; 3D animation, physical props</p>
              </div>
            </div>
            <div class="tla-phase-item">
              <span class="tla-phase-item__num">03</span>
              <div>
                <p class="tla-phase-item__label">Always</p>
                <p class="tla-phase-item__name">Story first, technology second</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Our Work ───────────────────────────────────── -->
    <section class="tla-pillars" id="pillars">
      <div class="tla-container">
        <div class="tla-section-header tla-fade">
          <span class="tla-overline">Flagship projects</span>
          <h2>Museum technology, built and in progress</h2>
          <div class="tla-divider"></div>
        </div>
      </div>
      <div class="tla-pillars__grid-wrap">
        <div class="tla-pillars__grid">
          <!-- Medelotapps & Touch Tables -->
          <div class="tla-pillar-card tla-fade tla-d1">
            <img src="/images/touch-tafel/IMG20260920161431.webp" alt="A custom-built Medelotapps touch table running at Museum Medelo in Meijel" loading="lazy" style="width:100%; aspect-ratio:4/3; object-fit:cover; border-radius:var(--tla-radius-md); margin-bottom:20px;" />
            <div class="tla-pillar-card__head">
              <span class="tla-pillar-card__num">01</span>
              <span class="tla-badge tla-badge--live">Live at Museum Medelo</span>
            </div>
            <h3>Medelotapps &amp; Touch Tables</h3>
            <p class="tla-pillar-card__tagline">Kiosk Software &middot; Custom Touch Tables &middot; Museum-Ready</p>
            <p class="tla-pillar-card__desc">Our WPF touch-kiosk platform is finished and running today on two machines at Museum Medelo &mdash; a touch table and a classroom board &mdash; shown live to the public at the museum&rsquo;s members-only opening on 20 September 2026. The software ships ready to go; the content inside is built bespoke for each venue&rsquo;s own archive and story.</p>
            <a href="/touchscreens/" class="tla-btn tla-btn--outline tla-btn--sm" style="margin-top:auto;">See Touch Station</a>
          </div>
          <!-- Brief aan Jan Truijen -->
          <div class="tla-pillar-card tla-fade tla-d2">
            <img src="/images/brief-aan-jan/prototype-20-09-2026/IMG20260920135209.webp" alt="The Brief aan Jan Truijen talking-portrait installation set up at Museum Medelo, with typewriter and antique desk" loading="lazy" style="width:100%; aspect-ratio:4/3; object-fit:cover; border-radius:var(--tla-radius-md); margin-bottom:20px;" />
            <div class="tla-pillar-card__head">
              <span class="tla-pillar-card__num">02</span>
              <span class="tla-badge tla-badge--dev">Working Prototype</span>
            </div>
            <h3>Brief aan Jan Truijen</h3>
            <p class="tla-pillar-card__tagline">Talking Portrait &middot; AI Voice &amp; 3D Animation &middot; Built to Travel</p>
            <p class="tla-pillar-card__desc">Visitors write a letter on a converted antique typewriter &mdash; and a historical portrait writes back, in character, with an AI voice and 3D facial animation. Shown live at Museum Medelo&rsquo;s opening on 20 September 2026, and built from day one to be customised for a new portrait, a new venue.</p>
            <a href="/jan-truijen/" class="tla-btn tla-btn--outline tla-btn--sm" style="margin-top:auto;">See the installation</a>
          </div>
          <!-- Puzzle Quests — Skeleton Key -->
          <div class="tla-pillar-card tla-fade tla-d3">
            <img src="/images/puzzle-quests/skeleton-key-wip/IMG20260901145952.webp" alt="The real, hand-built Skeleton Key prop for the Puzzle Quests walking route, a lion's-head brass key" loading="lazy" style="width:100%; aspect-ratio:4/3; object-fit:cover; border-radius:var(--tla-radius-md); margin-bottom:20px;" />
            <div class="tla-pillar-card__head">
              <span class="tla-pillar-card__num">03</span>
              <span class="tla-badge tla-badge--dev">In Build &amp; Testing</span>
            </div>
            <h3>Puzzle Quests &mdash; Skeleton Key</h3>
            <p class="tla-pillar-card__tagline">Walking Route &middot; Physical Prop &middot; No App, No Screen</p>
            <p class="tla-pillar-card__desc">A 5km walking quest through Meijel, carried by a hand-built brass key that senses eight hidden lock-stations. Hardware and route are built; we&rsquo;re now in build and testing ahead of the first real-player trail run.</p>
            <a href="/puzzlequests/" class="tla-btn tla-btn--outline tla-btn--sm" style="margin-top:auto;">See Puzzle Quests</a>
          </div>
          <!-- Immersive Worlds — VRVoyage -->
          <div class="tla-pillar-card tla-fade tla-d3">
            <img src="/images/immersive-worlds/Preview_1.png" alt="360&deg; VR still from VRVoyage — a canal boat passing beneath a bridge in 17th-century Amsterdam" loading="lazy" style="width:100%; aspect-ratio:4/3; object-fit:cover; border-radius:var(--tla-radius-md); margin-bottom:20px;" />
            <div class="tla-pillar-card__head">
              <span class="tla-pillar-card__num">04</span>
              <span class="tla-badge tla-badge--live">Live Now</span>
            </div>
            <h3>Immersive Worlds</h3>
            <p class="tla-pillar-card__tagline">360&deg; VR &middot; Live in Amsterdam &middot; VRVoyage</p>
            <p class="tla-pillar-card__desc">VRVoyage, our 70-minute 360&deg; VR journey through Amsterdam&rsquo;s Golden Age, is already a live tourist attraction &mdash; proof that our location-based storytelling works at city scale. A new Unreal Engine proof of concept shows what&rsquo;s possible next.</p>
            <a href="/immersive/" class="tla-btn tla-btn--outline tla-btn--sm" style="margin-top:auto;">See Immersive Worlds</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Also Running ───────────────────────────────── -->
    <section class="tla-featured">
      <div class="tla-container">
        <div class="tla-section-header tla-fade">
          <span class="tla-overline">Also running</span>
          <h2>Two more studio products, quietly running</h2>
          <div class="tla-divider"></div>
        </div>
        <p class="tla-fade" style="max-width:620px; margin:0 auto 40px; text-align:center; color:var(--tla-text-body);">Alongside our museum work, we run two live event-photography products &mdash; steady, self-service, and still growing.</p>
        <div class="tla-fade" style="display:grid; grid-template-columns:repeat(2,1fr); gap:28px; max-width:760px; margin:0 auto;">
          <div class="tla-value-card">
            <h3>WeddingCamBox</h3>
            <p>Self-service wedding photo booth &mdash; still taking bookings.</p>
            <a href="https://weddingcambox.nl" target="_blank" rel="noopener" class="tla-btn tla-btn--outline tla-btn--sm" style="margin-top:16px;">Visit WeddingCamBox</a>
          </div>
          <div class="tla-value-card">
            <h3>ShutterShare</h3>
            <p>The same idea, built for corporate events.</p>
            <a href="https://shuttershare.nl" target="_blank" rel="noopener" class="tla-btn tla-btn--outline tla-btn--sm" style="margin-top:16px;">Visit ShutterShare</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Roadmap ────────────────────────────────────── -->
    <section class="tla-roadmap" id="roadmap">
      <div class="tla-container">
        <div class="tla-section-header tla-fade">
          <span class="tla-overline">Where we&rsquo;re headed</span>
          <h2>Our roadmap</h2>
          <div class="tla-divider"></div>
        </div>
        <div class="tla-timeline tla-fade tla-d1">

          <!-- Now – Mid 2026 -->
          <div class="tla-timeline__item tla-timeline__item--active">
            <div class="tla-timeline__node"></div>
            <div class="tla-timeline__head">
              <h3>Now &mdash; Mid 2026</h3>
              <span class="tla-badge tla-badge--live">Active</span>
            </div>
            <p class="tla-timeline__desc">Medelotapps live at Museum Medelo (touch table + classroom board) &middot; Skeleton Key in build &amp; testing &middot; Touch Station platform launched</p>
          </div>

          <!-- Late 2026 -->
          <div class="tla-timeline__item tla-timeline__item--outlined">
            <div class="tla-timeline__node"></div>
            <div class="tla-timeline__head">
              <h3>Late 2026</h3>
              <span class="tla-badge tla-badge--dev">Upcoming</span>
            </div>
            <p class="tla-timeline__desc">Museum Medelo content build-out &middot; Skeleton Key first real-player trail run &middot; Jan Truijen moving toward a permanent installation</p>
          </div>

          <!-- 2027 -->
          <div class="tla-timeline__item tla-timeline__item--outlined">
            <div class="tla-timeline__node"></div>
            <div class="tla-timeline__head">
              <h3>2027</h3>
              <span class="tla-badge tla-badge--future">Planning</span>
            </div>
            <p class="tla-timeline__desc">Jan Truijen format pitched to a second venue &middot; Puzzle Quests: Living Chronicle &amp; Puzzle Lantern build</p>
          </div>

          <!-- 2028+ -->
          <div class="tla-timeline__item tla-timeline__item--dashed">
            <div class="tla-timeline__node"></div>
            <div class="tla-timeline__head">
              <h3>2028 &amp; Beyond</h3>
              <span class="tla-badge tla-badge--future">Future Vision</span>
            </div>
            <p class="tla-timeline__desc">Scale Immersive Worlds &middot; More talking-portrait installations across Dutch heritage venues &middot; Location-based storytelling for museums and historic sites</p>
          </div>

        </div>
      </div>
    </section>

    <!-- ── Values ─────────────────────────────────────── -->
    <section class="tla-values">
      <div class="tla-container">
        <div class="tla-section-header tla-fade">
          <span class="tla-overline">Our approach</span>
          <h2>Why The Lions Alliance</h2>
          <div class="tla-divider"></div>
        </div>
        <div class="tla-values__grid">
          <div class="tla-value-card tla-fade tla-d1">
            <h3>Story first</h3>
            <p>Every project starts with a place&rsquo;s story &mdash; a local legend, a historical figure, an archive most visitors never get to see.</p>
          </div>
          <div class="tla-value-card tla-fade tla-d2">
            <h3>Physical meets digital</h3>
            <p>Touch tables, talking portraits, printed puzzle props &mdash; we design experiences visitors can hold and explore, not just watch.</p>
          </div>
          <div class="tla-value-card tla-fade tla-d3">
            <h3>Built for the venue</h3>
            <p>No off-the-shelf platform. Every touch table, portrait, and quest is designed and built around one specific site and its story.</p>
          </div>
          <div class="tla-value-card tla-fade tla-d1">
            <h3>Made to be remembered</h3>
            <p>Our measure of success is simple: did the experience stay with someone after they walked out the door?</p>
          </div>
          <div class="tla-value-card tla-fade tla-d2">
            <h3>From a single object to a city-wide trail</h3>
            <p>The same thinking scales from a single talking portrait to an immersive, city-wide experience.</p>
          </div>
          <div class="tla-value-card tla-fade tla-d3">
            <h3>Long-term partners</h3>
            <p>We build lasting relationships with museums, heritage societies, and independent venues &mdash; not one-off transactions.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Contact ────────────────────────────────────── -->
    <section class="tla-contact" id="contact">
      <div class="tla-container">
        <span class="tla-overline tla-fade">Get in touch</span>
        <h2 class="tla-fade tla-d1">Let&rsquo;s build something<br />worth remembering</h2>
        <p class="tla-fade tla-d2">Whether you run a museum or heritage venue curious about touchscreens, a talking portrait, or a walking quest, or just want to explore a partnership &mdash; we&rsquo;d love to hear from you.</p>
        <div class="tla-contact__actions tla-fade tla-d3">
          <a href="/contact/" class="tla-btn tla-btn--gold">Send us a message</a>
          <a href="#pillars" class="tla-btn tla-btn--ghost">See our work</a>
        </div>
        <p class="tla-contact__email tla-fade tla-d3"><a href="mailto:hello@thelionsalliance.com">hello@thelionsalliance.com</a></p>
      </div>
    </section>

    <!-- ── Footer ─────────────────────────────────────── -->
    <footer class="tla-footer">
      <div class="tla-container">
        <div class="tla-footer__inner">
          <div class="tla-footer__brand">
            <div class="tla-footer__brand-row">
              <img src="/images/branding/lions-logo.webp" alt="" class="tla-footer__logo-img" />
              <span class="tla-footer__logo">The Lions <span>Alliance</span></span>
            </div>
            <span class="tla-footer__tagline">A Creative Experience Studio</span>
          </div>
          <nav class="tla-footer__links">
            <a href="#studio">Studio</a>
            <a href="#pillars">Our Work</a>
            <a href="#roadmap">Roadmap</a>
            <a href="/contact/">Contact</a>
            <a href="/jan-truijen/">Brief aan Jan Truijen</a>
            <a href="/immersive/">Immersive Worlds</a>
            <a href="/puzzlequests/">Puzzle Quests</a>
            <a href="/touchscreens/">Touch Station</a>
          </nav>
        </div>
        <p class="tla-footer__copy">&copy; {year} The Lions Alliance. All rights reserved.</p>
      </div>
    </footer>

    <!-- ── Scripts ─────────────────────────────────────── -->
    <script>
      // Scroll-aware nav
      const nav = document.getElementById('tla-nav');
      window.addEventListener('scroll', () => {
        nav.classList.toggle('scrolled', window.scrollY > 40);
      }, { passive: true });

      // Hamburger toggle
      const hamburger = document.getElementById('tla-hamburger');
      const mobileMenu = document.getElementById('tla-mobile-menu');
      hamburger.addEventListener('click', () => {
        hamburger.classList.toggle('active');
        mobileMenu.classList.toggle('open');
      });

      // Close mobile menu on link click
      mobileMenu.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          hamburger.classList.remove('active');
          mobileMenu.classList.remove('open');
        });
      });

      // Smooth scroll for anchor links
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', (e) => {
          const target = document.querySelector(anchor.getAttribute('href'));
          if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      });

      // IntersectionObserver for fade-in
      const faders = document.querySelectorAll('.tla-fade');
      const fadeObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('tla-visible');
            fadeObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
      faders.forEach(el => fadeObserver.observe(el));
    </script>
  </body>
</html>
