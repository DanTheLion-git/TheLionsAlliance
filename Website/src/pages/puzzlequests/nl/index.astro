---
// Catalogusbeschrijving. Engelse versie: ../index.astro (samen bewerken).
import CataloguePage from "../../../components/hall/CataloguePage.astro";
const wip = "/images/puzzle-quests/skeleton-key-wip";
---
<CataloguePage
  lang="nl"
  path="/puzzlequests/"
  title="Puzzle Quests | The Lions Alliance"
  description="Handgemaakte wandelquests voor musea en erfgoedlocaties, gedragen door een fysiek rekwisiet in plaats van een app. Skeleton Key is de eerste, in bouw en test met Museum Medelo in Meijel."
  crumb="Wandelquests"
  h1="Puzzle Quests"
  facts={[
    ["Object", "Wandelquest met een handgemaakt rekwisiet"],
    ["Eerste quest", "Skeleton Key: De Vlucht door de Peel"],
    ["Route", "Meijel, ongeveer 5 km, acht verborgen slotstations"],
    ["Locatie", "Museum Medelo, Tomveld 2, Meijel"],
    ["Partner", "Heemkundevereniging Medelo"],
    ["Status", "In bouw en test; proefwandeling volgt"],
  ]}
  lede="Een lokale legende, te voet ontdekt. Bezoekers nemen een handgemaakte sleutel mee het museum uit en volgen een route door het landschap. Geen app, geen scherm, geen gids nodig."
  plate={{
    src: `${wip}/IMG20260901145952.webp`, w: 1600, h: 1200, vt: "exhibit-key",
    alt: "De Skeleton Key in aanbouw: een 3D-geprinte sleutel met leeuwenkop en een doorzichtige schacht voor acht lampjes, op een groene werkmat",
    caption: "De Skeleton Key in aanbouw, nog zonder koperen afwerking. In de doorzichtige schacht zitten de acht lampjes.",
  }}
  cta={{ href: "/contact/nl/", label: "Informeer naar een quest" }}
  link={{ href: "#quest", label: "Lees de quest" }}
>
  <section class="cat-section">
    <h2>De legende achter de route</h2>
    <p>Skeleton Key is gebouwd rond een echte Meijelse legende. In de jaren 1730 vluchtten jonge mannen voor Pruisische ronselaars door de Peel, via een netwerk van schuilplaatsen. Bezoekers dragen een handgemaakte koperen sleutel die hen op pad stuurt om die vluchtroute zelf te vinden. De sleutel vertrekt met hen vanaf de museumbalie en wordt dringender naarmate zij dichter bij elk verborgen station komen, tot het verhaal compleet is en zij met hun antwoord terugkeren.</p>
    <p>De quest wordt gebouwd met <strong>Heemkundevereniging Medelo</strong>, de heemkundevereniging achter Museum Medelo, hetzelfde museum waar Medelotapps en Brief aan Jan Truijen draaien. Skeleton Key is de eerste van drie geplande quests voor deze locatie. Zodra hij bewezen is met echte spelers, gaan dezelfde hardware en opzet over naar Living Chronicle en Puzzle Lantern, en later naar andere locaties.</p>
  </section>

  <section class="cat-section">
    <h2>Wat een groep doet</h2>
    <ol class="cat-steps">
      <li><div><strong>De kit ophalen</strong><span>Aan de museumbalie: de sleutel, een boekje, een routekaart en een korte introductie op het verhaal. Geen app, geen scherm, geen installatie.</span></div></li>
      <li><div><strong>De route lopen</strong><span>Door het dorp en het landschap eromheen. De sleutel reageert bij elk station en geeft telkens een nieuw stukje van het verhaal prijs.</span></div></li>
      <li><div><strong>Terug naar de balie</strong><span>Met een ingevuld boekje en een sleutel die hun voortgang laat oplichten. De medewerker controleert het, zet een stempel en deelt nog &eacute;&eacute;n extra detail uit het archief. Binnen vijf minuten staat de kit klaar voor de volgende groep.</span></div></li>
    </ol>
  </section>

  <section class="cat-section" id="quest">
    <h2>De quests</h2>
    <div class="cat-sub">
      <h3>De Vlucht door de Peel <span class="tla-badge tla-badge--dev">In bouw en test</span></h3>
      <dl class="cat-table">
        <dt>Moeilijkheid</dt><dd>3 van 4</dd>
        <dt>Duur</dt><dd>75&ndash;95 minuten</dd>
        <dt>Afstand</dt><dd>Ongeveer 5 km</dd>
        <dt>Groep</dt><dd>2&ndash;6 personen, vanaf 10 jaar</dd>
        <dt>Mechanisme</dt><dd>Een keten van sloten, die de sleutel via radio aanvoelt</dd>
      </dl>
      <p class="cat-sub__story">Tussen 1713 en 1740 stuurde de Pruisische koning Frederik Wilhelm I ronselaars over de grens om bijzonder lange jonge mannen te verzamelen voor zijn elite Riesengarde. Wie vluchtte, gebruikte een geheim netwerk van veilige onderkomens door de Peel. Wie Meijel bereikte, was vrij. Zij vestigden zich, trouwden er en kregen lange kinderen. Het is in de archieven gedocumenteerd als de reden waarom in Meijel historisch meer lange mannen wonen dan in de omliggende dorpen.</p>
      <p>De Skeleton Key is de hoofdsleutel van de wachter. Acht slotstations zitten verstopt in boomstammen, bemoste stenen en wandelpalen langs de route, onzichtbaar voor een toevallige voorbijganger. Elk station licht op zodra de sleutel het aanvoelt. Bij elk slot wordt de sleutel omgedraaid, een NFC-scan wordt geactiveerd, en er licht weer een rune langs de schacht op door het verouderde koper heen. Bij het laatste slot branden alle acht, en de wandelaar spreekt het antwoord hardop uit aan de museumbalie, als bewijs van de tocht.</p>
    </div>
    <div class="cat-sub">
      <h3>Living Chronicle: Het Pad van Dikke Mie <span class="tla-badge tla-badge--future">Gepland</span></h3>
      <p>Een zichzelf beschrijvende, in leer gebonden kroniek die zich vult tijdens een herdenkingsroute voor een vergeten 18e-eeuwse zwerfster. Het rekwisiet wordt gebouwd zodra de proefwandeling van Skeleton Key het format heeft bewezen.</p>
    </div>
    <div class="cat-sub">
      <h3>Puzzle Lantern: De Schat van het Dolle Moer <span class="tla-badge tla-badge--future">Gepland</span></h3>
      <p>Een Victoriaanse lantaarn die bij elk station met uv-licht verborgen aanwijzingen onthult, te ontcijferen met een veldjournaal. Dezelfde verhalenfamilie, na Skeleton Key in de bouwwachtrij.</p>
    </div>
  </section>

  <section class="cat-section" id="venue">
    <h2>De hardware is herbruikbaar. Het verhaal is het maatwerk.</h2>
    <div class="cat-lists">
      <div>
        <h3>Wat hetzelfde blijft</h3>
        <ul>
          <li>De hardware van het rekwisiet.</li>
          <li>Het puzzelraamwerk.</li>
          <li>Hoe de balie het draait.</li>
        </ul>
      </div>
      <div>
        <h3>Wat wij voor uw locatie maken</h3>
        <ul>
          <li>Het verhaal.</li>
          <li>Het boekje.</li>
          <li>De route.</li>
          <li>Hoe de stations vermomd zijn.</li>
        </ul>
      </div>
    </div>
  </section>

  <Fragment slot="plates">
    <figure class="cat-plate cat-plate--wide">
      <img src={`${wip}/IMG20260608130746.webp`} width="1600" height="1200" loading="lazy" data-unveil
           alt="De werkbank van de Skeleton Key midden in de bouw: gereedschap, elektronica en onderdelenbakjes" />
      <figcaption><b>Plaat 2.</b> De werkbank, midden in de bouw. Nog volop in ontwikkeling.</figcaption>
    </figure>
    <figure class="cat-plate">
      <img src={`${wip}/IMG20260608105918.webp`} width="1600" height="1200" loading="lazy" data-unveil
           alt="Een klein besturingsprintje met connectoren, vastgeklemd in een derde hand op de werkbank" />
      <figcaption><b>Plaat 3.</b> Elektronica voor de sleutel, met de hand gesoldeerd.</figcaption>
    </figure>
  </Fragment>

  <Fragment slot="enquiry">
    <div class="cat-enquiry__grid">
      <div>
        <h2>Een quest voor uw museum of dorp</h2>
        <p>Vertel ons over uw plek en het verhaal dat er ligt. Wij antwoorden binnen een of twee werkdagen.</p>
        <div class="cat-enquiry__actions">
          <a href="/contact/nl/" class="tla-btn">Neem contact op</a>
        </div>
      </div>
      <div class="cat-enquiry__for">
        Gemaakt voor
        <ul>
          <li>Streek- en heemkundemusea</li>
          <li>Heemkundeverenigingen</li>
          <li>Campings en erfgoedroutes</li>
          <li>Toerismeorganisaties</li>
        </ul>
      </div>
    </div>
  </Fragment>
</CataloguePage>
