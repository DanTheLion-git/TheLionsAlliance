---
import "../../../styles/homepage.css";
import "../../../styles/puzzlequests.css";
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Puzzle Quests &mdash; The Lions Alliance</title>
    <meta name="description" content="Puzzle Quests is een familie van handgemaakte erfgoedwandelervaringen van The Lions Alliance. De Skeleton Key — onze eerste quest — is in prototype en op weg naar Museum Medelo in Meijel." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="en" href="https://thelionsalliance.com/puzzlequests/" />
    <link rel="alternate" hreflang="nl" href="https://thelionsalliance.com/puzzlequests/nl/" />
    <link rel="alternate" hreflang="x-default" href="https://thelionsalliance.com/puzzlequests/" />
  </head>
  <body class="tla-page pl-body">

    <!-- ── Navigatie ──────────────────────────────────── -->
    <nav class="tla-nav" id="tla-nav">
      <div class="tla-nav__inner tla-container">
        <a href="/" class="tla-nav__logo">The Lions <span>Alliance</span></a>
        <ul class="tla-nav__links">
          <li><a href="#overview">Overzicht</a></li>
          <li><a href="#pilot">Pilot Meijel</a></li>
          <li><a href="#skeleton-key">Skeleton Key</a></li>
          <li><a href="#adapt">Voor uw locatie</a></li>
        </ul>
        <div class="tla-nav__actions">
          <a href="/puzzlequests/" class="tla-nav__lang" hreflang="en" lang="en" title="View in English">EN</a>
          <a href="/contact/" class="tla-nav__cta tla-nav__cta--gold">Contact</a>
          <a href="/" class="tla-nav__cta">&larr; Studio</a>
        </div>
        <button class="tla-nav__hamburger" id="hamburger" aria-label="Menu openen">
          <span></span><span></span><span></span>
        </button>
      </div>
      <div class="tla-nav__mobile" id="mobile-menu">
        <a href="#overview">Overzicht</a>
        <a href="#pilot">Pilot Meijel</a>
        <a href="#skeleton-key">Skeleton Key</a>
        <a href="#adapt">Voor uw locatie</a>
        <a href="/contact/">Contact</a>
        <a href="/puzzlequests/" hreflang="en" lang="en">View in English</a>
        <a href="/">&larr; Terug naar de studio</a>
      </div>
    </nav>

    <!-- ── Hero ───────────────────────────────────────── -->
    <section class="pl-hero" id="home">
      <div class="tla-container pl-hero__inner">
        <div class="pl-hero__text tla-fade">
          <div class="pl-hero__breadcrumb">
            <a href="/">The Lions Alliance</a>
            <span class="pl-hero__breadcrumb-sep">/</span>
            <span>Pijler &middot; Experiences</span>
          </div>
          <div class="pl-hero__badges">
            <span class="tla-badge tla-badge--built">Prototype klaar</span>
            <span class="tla-badge tla-badge--dev">In ontwikkeling</span>
            <span class="tla-badge tla-badge--live">Erfgoedpilot 2026</span>
          </div>
          <h1 class="pl-hero__title">Puzzle <em>Quests</em></h1>
          <p class="pl-hero__subtitle">
            De Skeleton Key &mdash; onze eerste handgemaakte erfgoedwandelervaring &mdash; is in prototype bij ons in de studio: de leeuwenkop is geprint, de elektronica is gesoldeerd, en de behuizing wordt samengesteld. Een lokale legende meegedragen in de hand van de bezoeker, als een bronzen sleutel die reageert op verborgen slotstations langs de route. Geen app, geen scherm, geen gids nodig.
          </p>
          <div class="pl-hero__ctas">
            <a href="#collaborate" class="tla-btn tla-btn--gold">Breng dit naar uw locatie</a>
            <a href="#skeleton-key" class="tla-btn tla-btn--outline">Bekijk de Skeleton Key &darr;</a>
          </div>
        </div>
        <div class="pl-hero__visual tla-fade tla-d1">
          <figure class="pl-render">
            <img src="/images/puzzle-quests/skeleton-key/sk-unlit.webp" alt="De Skeleton Key — een sierlijk gegoten leeuwenkop als boog, een gegraveerde schacht met verborgen runeposities en een heraldische NFC-baard, op een donkere studiofoto. Prototype-render." loading="eager" />
          </figure>
          <span class="pl-render__caption">De Skeleton Key &mdash; prototype-render &middot; <em>De Vlucht door de Peel</em></span>
        </div>
      </div>
    </section>

    <!-- ── Het idee ───────────────────────────────────── -->
    <section class="pl-overview" id="overview">
      <div class="tla-container pl-overview__inner">
        <div class="pl-overview__text tla-fade">
          <span class="tla-overline">Het idee</span>
          <h2 class="tla-section-header pl-section-header--left">Een lokale legende, gelopen door het landschap dat haar bewaart</h2>
          <p>
            Puzzle Quests is een familie van handgemaakte wandelervaringen. Elke wandeling begint en eindigt aan de balie van het samenwerkende museum en volgt een route door het dorp, het veen of het erfgoedlandschap eromheen. Terwijl de bezoeker loopt, reageert het rekwisiet in zijn hand op de wereld om hem heen &mdash; het licht op, trilt, schrijft zichzelf, onthult verborgen details.
          </p>
          <p>
            Elke quest is gebouwd rond een specifieke lokale legende of een verhaal uit het archief. Het verhaal is de ruggegraat van de ervaring; het rekwisiet is de manier waarop de bezoeker erin stapt. Wij ontwerpen alles van begin tot eind: het narratief, het rekwisiet, de route, het boekje, de puzzel, de stations onderweg en de briefing voor het balie-personeel.
          </p>
          <p>
            De eerste drie versies worden ontwikkeld voor <strong>Museum Medelo in Meijel</strong>, in samenwerking met Heemkundevereniging Medelo. De hardware, de puzzelraamwerken en het draaiboek zijn opgezet met replicatie in gedachten &mdash; zodra de pilot in Meijel het format heeft bewezen, kunnen dezelfde rekwisieten met enkele tientallen uren ontwerpwerk worden aangepast voor andere streekmusea en erfgoedlocaties.
          </p>
          <div class="pl-tags">
            <span class="pl-tag">Musea &amp; erfgoed</span>
            <span class="pl-tag">Lokale legenden</span>
            <span class="pl-tag">Wandelroutes</span>
            <span class="pl-tag">Schoolprogramma&rsquo;s</span>
            <span class="pl-tag">Omzetdeling met museum</span>
            <span class="pl-tag">Geen app, geen gids</span>
          </div>
        </div>
        <div class="pl-overview__visual tla-fade tla-d1">
          <figure class="pl-sketch">
            <img src="/images/puzzle-quests/Concept_WorkingDesk.png" alt="Werkbank van de studio met een geopende archiefmap van Heemkundevereniging Medelo, een hand die met een ganzenveer schrijft, drie ontwerpbladen van de rekwisieten op de achtergrond, en een procesoverzicht van archief tot museumbalie." loading="lazy" />
          </figure>
          <span class="pl-sketch__caption">Werkbank &mdash; van het Medelo-archief naar een gelopen route</span>
        </div>
      </div>
    </section>

    <div class="tla-divider"></div>

    <!-- ── Pilot Meijel ───────────────────────────────── -->
    <section class="pl-pilot" id="pilot">
      <div class="tla-container">
        <div class="tla-fade" style="text-align:center;">
          <span class="tla-overline">Eerste pilot</span>
          <h2 class="tla-section-header">Museum Medelo, Meijel</h2>
        </div>
        <div class="pl-pilot__grid">
          <div class="pl-pilot__text tla-fade">
            <p>
              De eerste drie Puzzle Quests worden ontwikkeld in samenwerking met <strong>Heemkundevereniging Medelo</strong> &mdash; de heemkundevereniging die Museum Medelo aan het Tomveld 2 in Meijel beheert. Elke quest is geworteld in een echt verhaal uit het Medelo-archief: een vlucht voor Pruisische ronselaars in de jaren 1730, het leven van een Belgische zwerfster die veertig jaar door de Peel trok, en de resten van een Romeinse soldaat die in het veen langs de weg Meijel&ndash;Sevenum werden gevonden.
            </p>
            <p>
              De samenwerking met Medelo geeft ons drie dingen tegelijk: archiefdiepte die elk verhaal geloofwaardig maakt, een startlocatie waar bezoekers de kit ophalen en aan het eind een stempel komen halen, en een operationele staat van dienst die helpt om andere streekmusea te benaderen (Limburgs Museum, Streekmuseum De Locht en partnerinstellingen in Brabantse en Limburgse vestingsteden).
            </p>
            <p>
              Ons doel voor 2026 is om de Skeleton Key van prototype naar live museum-operatie te brengen. De andere twee quests volgen zodra de kit en het draaiboek bewezen zijn.
            </p>
          </div>
          <ul class="pl-pilot__facts tla-fade tla-d1">
            <li><span class="pl-pilot__label">Locatie</span><span class="pl-pilot__value">Museum Medelo, Tomveld 2, Meijel</span></li>
            <li><span class="pl-pilot__label">Erfgoedpartner</span><span class="pl-pilot__value">Heemkundevereniging Medelo</span></li>
            <li><span class="pl-pilot__label">Eerste quest live</span><span class="pl-pilot__value">Streefdatum eind 2026</span></li>
            <li><span class="pl-pilot__label">Format</span><span class="pl-pilot__value">Wandelroute, 45&ndash;95 min, terugkomst aan de balie</span></li>
            <li><span class="pl-pilot__label">Doelgroepen</span><span class="pl-pilot__value">Gezinsbezoek &middot; schoolklassen (90&ndash;120 min) &middot; stellen</span></li>
            <li><span class="pl-pilot__label">Verdienmodel</span><span class="pl-pilot__value">Omzetdeling met het ontvangende museum</span></li>
          </ul>
        </div>
      </div>
    </section>

    <div class="tla-divider"></div>

    <!-- ── Hoe het werkt ──────────────────────────────── -->
    <section class="pl-steps-section" id="how-it-works">
      <div class="tla-container">
        <div class="tla-fade" style="text-align:center;">
          <span class="tla-overline">Hoe het werkt</span>
          <h2 class="tla-section-header">De bezoekerservaring, in drie stappen</h2>
        </div>
        <div class="pl-steps">
          <div class="pl-step tla-fade">
            <div class="pl-step__number">I</div>
            <div class="pl-step__title">Haal de kit op</div>
            <div class="pl-step__desc">Aan de balie van het museum: een rekwisiet, een boekje, een routekaart en een korte introductie op het verhaal. Geen app, geen scherm, geen installatie.</div>
          </div>
          <div class="pl-step tla-fade tla-d1">
            <div class="pl-step__number">II</div>
            <div class="pl-step__title">Loop de route</div>
            <div class="pl-step__desc">De route loopt door het dorp en het omliggende landschap. Het rekwisiet reageert bij elk station &mdash; via een slot, een pagina of een lantaarn &mdash; en onthult telkens een nieuw stukje van het verhaal.</div>
          </div>
          <div class="pl-step tla-fade tla-d2">
            <div class="pl-step__number">III</div>
            <div class="pl-step__title">Kom terug naar de balie</div>
            <div class="pl-step__desc">Bezoekers komen terug met een ingevuld boekje en een rekwisiet dat hun voortgang oplicht. De medewerker controleert het resultaat, zet een stempel op de routekaart en deelt tijdens dat gesprek nog &eacute;&eacute;n extra detail uit het archief. Binnen vijf minuten staat de kit klaar voor de volgende groep.</div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Skeleton Key (vlaggenschip) ───────────────── -->
    <section class="pl-quests" id="skeleton-key">
      <div class="tla-container">
        <div class="tla-fade" style="text-align:center;">
          <span class="tla-overline">Quest I &middot; In fabricage</span>
          <h2 class="tla-section-header">De Skeleton Key</h2>
          <p class="pl-quests__intro">De eerste quest heeft de ontwerpfase verlaten. Het 3D-model is geprint, de elektronica is gesoldeerd en de behuizing wordt samengesteld. Dit is wat een bezoeker aan de museumbalie ophaalt.</p>
        </div>

        <!-- ── Het rekwisiet ───────────────────────── -->
        <article class="pl-quest pl-quest--key tla-fade" id="quest-key">
          <div class="pl-quest__visual">
            <figure class="pl-render pl-render--blend">
              <img src="/images/puzzle-quests/skeleton-key/sk-head.webp" alt="Close-up render van de leeuwenkop van de Skeleton Key: een sierlijk bronzen frame met acanthus-bladwerk rondom een gedetailleerd leeuwengezicht in heraldische stijl, circa 1730." loading="lazy" />
            </figure>
            <span class="pl-render__caption">De Skeleton Key &mdash; leeuwenkop, prototype-render &middot; versie I</span>
          </div>
          <div class="pl-quest__body">
            <div class="pl-quest__eyebrow">Quest I &middot; Skeleton Key</div>
            <h3 class="pl-quest__title">De Vlucht door de Peel</h3>
            <p class="pl-quest__story">
              Tussen 1713 en 1740 stuurde de Pruisische koning Frederik Wilhelm I ronselaars over de grens om bijzonder lange jonge mannen te verzamelen voor zijn elite Riesengarde. Wie vluchtte, gebruikte een geheim netwerk van veilige onderkomens door de Peel. Wie Meijel bereikte, was vrij &mdash; zij vestigden zich, trouwden er, en kregen lange kinderen. Het is in de archieven gedocumenteerd als de reden waarom in Meijel historisch meer lange mannen wonen dan in de omliggende dorpen.
            </p>
            <p>
              De Skeleton Key is de hoofdsleutel van de wachter. Acht echte slotstations &mdash; verstopt in boomstammen, bemoste stenen en houten wandelpalen langs de route &mdash; dragen elk &eacute;&eacute;n letter van het woord <strong>VRIJHEID</strong>. De sleutel voelt het volgende station via een radiosignaal en pulseert sterker naarmate de wandelaar dichterbij komt. Bij elk slot wordt de sleutel fysiek omgedraaid, een NFC-scan wordt geactiveerd, en een van de runen langs de schacht licht zacht op door het verouderde brons heen. Bij het achtste slot branden alle runen. De wandelaar spreekt het woord hardop uit aan de museumbalie &mdash; dat is het bewijs van de tocht.
            </p>
            <ul class="pl-quest__chips">
              <li><span>Moeilijkheid</span><strong>&#9733;&#9733;&#9733;&#9734;</strong></li>
              <li><span>Duur</span><strong>75&ndash;95 min</strong></li>
              <li><span>Afstand</span><strong>~5 km</strong></li>
              <li><span>Groep</span><strong>2&ndash;6</strong></li>
              <li><span>Leeftijd</span><strong>10+</strong></li>
              <li><span>Mechanisme</span><strong>Slotketen &middot; radio-nabijheid &middot; woord van acht letters</strong></li>
            </ul>
            <div class="pl-quest__status">
              <span class="pl-quest__status-dot"></span>
              <span>Prototype gefabriceerd &middot; Twee harsafdrukken gereed &middot; Elektronische componenten gesoldeerd &middot; Behuizing in samenstelling</span>
            </div>
          </div>
        </article>

        <!-- ── Slotstations ──────────────────────────── -->
        <article class="pl-quest pl-quest--key-stations tla-fade tla-d1">
          <div class="pl-quest__visual pl-quest__visual--wide">
            <figure class="pl-sketch">
              <img src="/images/puzzle-quests/SkeletonKey_Stations.png" alt="Drie verschijningsvormen van de slotstations voor de Skeleton Key &mdash; boomstam, bemoste steen en Nederlandse wandelpaal &mdash; elk met een verborgen sleutelgat en aders die oplichten als de sleutel dichtbij is." loading="lazy" />
            </figure>
            <span class="pl-sketch__caption">Slotstations &mdash; boomstam, steen, wandelpaal; onzichtbaar voor voorbijgangers, levend voor wie de sleutel draagt</span>
          </div>
          <div class="pl-quest__body pl-quest__body--narrow">
            <p>
              De stations zijn gemaakt om in het landschap te verdwijnen. Een toevallige voorbijganger loopt erlangs zonder iets te merken &mdash; alleen de bezoeker met de sleutel ziet de verborgen lichtaderen langzaam pulseren wanneer hij dichterbij komt. Drie verschijningsvormen wisselen elkaar af op de route: gegoten boomschors om een echte boom, een Jesmonite-replica van een zwerfsteen, en een Nederlandse wandelpaal. &Eacute;&eacute;n extra station &mdash; de val van de ronselaars &mdash; lokt haastige wandelaars die de kleurketen negeren.
            </p>
          </div>
        </article>

      </div>
    </section>

    <!-- ── Magisch diagram ──────────────────────────────── -->
    <section class="pl-diagram tla-fade" id="key-diagram">
      <div class="tla-container">
        <div style="text-align:center;">
          <span class="tla-overline">Wat u vasthoudt</span>
          <h2 class="tla-section-header">De sleutel, ontleed</h2>
          <p class="pl-diagram__intro">Vier systemen die samenwerken &mdash; licht, geluid, trilling en radio-sensing &mdash; elk verborgen in een rekwisiet dat aanvoelt alsof het thuis hoort in de jaren 1730.</p>
        </div>

        <div class="pl-diagram__grid" id="diagram-grid">
          <svg class="pl-diagram__lines" id="diagram-lines" aria-hidden="true"></svg>

          <figure class="pl-diagram__key-fig">
            <img class="pl-diagram__key-img" id="diagram-key-img"
                 src="/images/puzzle-quests/skeleton-key/sk-front-back.webp"
                 alt="Voor- en achterkant van de Skeleton Key — met leeuwenkop, gegraveerde schacht en NFC-baard."
                 loading="lazy" />
          </figure>

          <div class="pl-diagram__side">
            <div class="pl-diagram__callout" data-anchor="0.22,0.18">
              <span class="pl-diagram__c-icon">&#9889;</span>
              <strong class="pl-diagram__c-name">Opladen &amp; Activeren</strong>
              <span class="pl-diagram__c-desc">USB-C oplaadpoort en activeerknop, verborgen in de kroon van de leeuwenkop.</span>
            </div>
            <div class="pl-diagram__callout" data-anchor="0.16,0.44">
              <span class="pl-diagram__c-icon">&#128266;</span>
              <strong class="pl-diagram__c-name">Spreekt &amp; Brult</strong>
              <span class="pl-diagram__c-desc">Speaker en trilmotor. De sleutel pulseert en gromt naarmate een station dichterbij komt.</span>
            </div>
          </div>

          <div class="pl-diagram__side">
            <div class="pl-diagram__callout" data-anchor="0.30,0.35">
              <span class="pl-diagram__c-icon">&#128065;</span>
              <strong class="pl-diagram__c-name">Statusoog</strong>
              <span class="pl-diagram__c-desc">Kleur-LED op de achterkant. Aan&thinsp;/&thinsp;stand-by&thinsp;/&thinsp;station gevonden &mdash; in &eacute;&eacute;n oogopslag leesbaar.</span>
            </div>
            <div class="pl-diagram__callout" data-anchor="0.88,0.52">
              <span class="pl-diagram__c-icon">&#10022;</span>
              <strong class="pl-diagram__c-name">Slotdetectie</strong>
              <span class="pl-diagram__c-desc">NFC-lezer ingebouwd in de baard. In het slotkastje gestoken om de rune-onthulling te activeren.</span>
            </div>
          </div>
        </div>

        <p class="pl-diagram__note">Annotatierender in voorbereiding &mdash; het diagram bepaalt wat de definitieve afbeelding moet tonen.</p>
      </div>
    </section>

    <!-- ── Interactieve runewandeling ────────────────────── -->
    <section class="pl-walk" id="rune-walk">
      <div class="tla-container">
        <div class="tla-fade" style="text-align:center;">
          <span class="tla-overline">Het mechanisme in beweging</span>
          <h2 class="tla-section-header">Elk slot onthult een rune</h2>
          <p class="pl-walk__intro">Sleep de wandelaar langs de route. Bij elk station verandert het sleutelbeeld en gloeit er nog een Peelschrift-rune op langs de schacht. Tijdelijke tekens &mdash; de definitieve Peelschrift-tekens volgen zodra het ontwerp is afgerond.</p>
        </div>

        <div class="tla-fade">
          <div class="pl-walk__display">
            <figure class="pl-walk__key-fig">
              <img id="walk-key-img" class="pl-walk__key-img"
                   src="/images/puzzle-quests/skeleton-key/sk-unlit.webp"
                   alt="De Skeleton Key — het runebeeld wordt bijgewerkt naarmate de wandelaar de route loopt"
                   loading="lazy" />
            </figure>
            <div class="pl-walk__runes" aria-live="polite" aria-label="Runenprogressie">
              <span class="pl-walk__rune" data-rune="&#5792;">&#9676;</span>
              <span class="pl-walk__rune" data-rune="&#5794;">&#9676;</span>
              <span class="pl-walk__rune" data-rune="&#5798;">&#9676;</span>
              <span class="pl-walk__rune" data-rune="&#5800;">&#9676;</span>
              <span class="pl-walk__rune" data-rune="&#5809;">&#9676;</span>
              <span class="pl-walk__rune" data-rune="&#5810;">&#9676;</span>
              <span class="pl-walk__rune" data-rune="&#5825;">&#9676;</span>
              <span class="pl-walk__rune" data-rune="&#5848;">&#9676;</span>
            </div>
          </div>

          <div class="pl-walk__stage-wrap">
            <svg id="walk-svg" class="pl-walk__svg" viewBox="0 0 900 240" preserveAspectRatio="xMidYMid meet"
                 role="img" aria-label="Interactieve wandelroute — sleep om door de stations heen te lopen">
              <defs>
                <symbol id="icon-rock" viewBox="-15 -16 30 24" overflow="visible">
                  <path d="M-10,4 C-13,-7 -7,-16 0,-14 C7,-12 13,-7 11,4 C9,11 -8,11 -10,4Z"
                        fill="#9B8B78" stroke="#7A6A5A" stroke-width="0.7"/>
                  <path d="M-5,-7 C-2,-12 3,-11 5,-7" stroke="#C0B098" stroke-width="0.8" fill="none" opacity="0.55"/>
                </symbol>
                <symbol id="icon-stump" viewBox="-12 -16 24 24" overflow="visible">
                  <rect x="-9" y="-7" width="18" height="13" rx="1" fill="#7A5A42"/>
                  <ellipse cx="0" cy="-7" rx="9" ry="3.5" fill="#6A4A35"/>
                  <ellipse cx="0" cy="6"  rx="9" ry="3"   fill="#6A4A35"/>
                  <path d="M-3,-7 L-2,-14 M3,-7 L3,-13 M7,-4 L9,-10"
                        stroke="#9B7050" stroke-width="1.2" fill="none" stroke-linecap="round"/>
                </symbol>
                <symbol id="icon-pole" viewBox="-8 -24 16 32" overflow="visible">
                  <rect x="-2.5" y="-22" width="5" height="28" rx="1.5" fill="#8B7352"/>
                  <ellipse cx="0" cy="-22" rx="6"  ry="2.5" fill="#A08860"/>
                  <ellipse cx="0" cy="-22" rx="4"  ry="1.8" fill="#C0A878"/>
                </symbol>
              </defs>

              <line x1="0" y1="160" x2="900" y2="160" stroke="rgba(176,141,87,0.07)" stroke-width="1"/>

              <path id="walk-path"
                    d="M 20,150 C 80,90 170,195 250,150 S 400,90 470,150 S 600,195 680,150 S 820,90 880,150"
                    stroke="rgba(176,141,87,0.38)"
                    stroke-width="3"
                    stroke-dasharray="8 6"
                    fill="none"
                    stroke-linecap="round"/>
            </svg>
