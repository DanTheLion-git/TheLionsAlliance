    <!-- ── Scripts ─────────────────────────────────────── -->
    <script>
      /* Nav scroll */
      const nav = document.getElementById('tla-nav');
      if (nav) {
        window.addEventListener('scroll', () => {
          nav.classList.toggle('scrolled', window.scrollY > 40);
        });
      }

      /* Fade-in on scroll */
      const faders = document.querySelectorAll('.tla-fade');
      if (faders.length && 'IntersectionObserver' in window) {
        const obs = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('tla-visible');
                obs.unobserve(e.target);
              }
            });
          },
          { threshold: 0.15 }
        );
        faders.forEach((el) => obs.observe(el));
      } else {
        faders.forEach((el) => el.classList.add('tla-visible'));
      }

      /* Hamburger */
      const hamburger = document.getElementById('hamburger');
      const mobileMenu = document.getElementById('mobile-menu');
      if (hamburger && mobileMenu) {
        hamburger.addEventListener('click', () => {
          const open = mobileMenu.classList.toggle('open');
          hamburger.classList.toggle('open', open);
          hamburger.setAttribute('aria-expanded', String(open));
        });
        mobileMenu.querySelectorAll('a').forEach((a) => {
          a.addEventListener('click', () => {
            mobileMenu.classList.remove('open');
            hamburger.classList.remove('open');
            hamburger.setAttribute('aria-expanded', 'false');
          });
        });
      }

      /* ── Diagram annotation lines ───────────────────── */
      (function initDiagram() {
        const grid   = document.getElementById('diagram-grid');
        const keyImg = document.getElementById('diagram-key-img');
        const linesEl= document.getElementById('diagram-lines');
        if (!grid || !keyImg || !linesEl) return;

        function draw() {
          linesEl.innerHTML = '';
          if (window.innerWidth <= 960) return;
          const gridRect = grid.getBoundingClientRect();
          const imgRect  = keyImg.getBoundingClientRect();
          document.querySelectorAll('.pl-diagram__callout').forEach((c) => {
            const [ax, ay] = c.dataset.anchor.split(',').map(Number);
            const ancX = (imgRect.left - gridRect.left) + ax * imgRect.width;
            const ancY = (imgRect.top  - gridRect.top)  + ay * imgRect.height;
            const cR   = c.getBoundingClientRect();
            const cx   = cR.left - gridRect.left + cR.width  / 2;
            const cy   = cR.top  - gridRect.top  + cR.height / 2;
            const NS   = 'http://www.w3.org/2000/svg';
            const line = document.createElementNS(NS, 'line');
            line.setAttribute('x1', cx);   line.setAttribute('y1', cy);
            line.setAttribute('x2', ancX); line.setAttribute('y2', ancY);
            line.setAttribute('stroke', 'rgba(176,141,87,0.55)');
            line.setAttribute('stroke-width', '1.5');
            line.setAttribute('stroke-dasharray', '5 4');
            const dot = document.createElementNS(NS, 'circle');
            dot.setAttribute('cx', ancX); dot.setAttribute('cy', ancY);
            dot.setAttribute('r', '4');
            dot.setAttribute('fill', 'rgba(176,141,87,0.55)');
            linesEl.appendChild(line);
            linesEl.appendChild(dot);
          });
        }

        if (keyImg.complete) draw(); else keyImg.addEventListener('load', draw);
        let rt;
        window.addEventListener('resize', () => { clearTimeout(rt); rt = setTimeout(draw, 120); });
      })();

      /* ── Interactive Rune Walk ──────────────────────── */
      (function initWalk() {
        const svgEl    = document.getElementById('walk-svg');
        const walkPath = document.getElementById('walk-path');
        const keyImg   = document.getElementById('walk-key-img');
        const runeEls  = document.querySelectorAll('.pl-walk__rune');
        if (!svgEl || !walkPath || !keyImg) return;

        const pathLen   = walkPath.getTotalLength();
        const stationTs = [0.08,0.17,0.26,0.35,0.44,0.53,0.62,0.71,0.80,0.91];
        const iconCycle = ['rock','stump','pole','rock','stump','pole','rock','stump','pole','rock'];
        const keyImgs   = [
          '/images/puzzle-quests/skeleton-key/sk-unlit.webp',
          '/images/puzzle-quests/skeleton-key/sk-lit-1.webp',
          '/images/puzzle-quests/skeleton-key/sk-lit-2.webp',
          '/images/puzzle-quests/skeleton-key/sk-lit-3.webp',
          '/images/puzzle-quests/skeleton-key/sk-lit-4.webp',
          '/images/puzzle-quests/skeleton-key/sk-lit-5.webp',
          '/images/puzzle-quests/skeleton-key/sk-lit-6.webp',
          '/images/puzzle-quests/skeleton-key/sk-lit-7.webp',
          '/images/puzzle-quests/skeleton-key/sk-lit-8.webp',
          '/images/puzzle-quests/skeleton-key/sk-lit-9.webp',
          '/images/puzzle-quests/skeleton-key/sk-lit-10.webp',
        ];
        const NS = 'http://www.w3.org/2000/svg';

        stationTs.forEach((t, i) => {
          const pt = walkPath.getPointAtLength(t * pathLen);
          const g  = document.createElementNS(NS, 'g');
          g.setAttribute('class', 'walk-station');
          g.setAttribute('transform', `translate(${pt.x.toFixed(1)},${pt.y.toFixed(1)})`);
          const iconG = document.createElementNS(NS, 'g');
          iconG.setAttribute('transform', 'translate(0,-40)');
          const use = document.createElementNS(NS, 'use');
          use.setAttribute('href', `#icon-${iconCycle[i]}`);
          use.setAttribute('width', '30'); use.setAttribute('height', '28');
          use.setAttribute('x', '-15');   use.setAttribute('y', '-24');
          iconG.appendChild(use);
          const dot = document.createElementNS(NS, 'circle');
          dot.setAttribute('r', '5');
          dot.setAttribute('fill', 'rgba(176,141,87,0.18)');
          dot.setAttribute('stroke', 'rgba(176,141,87,0.5)');
          dot.setAttribute('stroke-width', '1.5');
          g.appendChild(iconG);
          g.appendChild(dot);
          svgEl.appendChild(g);
        });

        const walkerG = document.createElementNS(NS, 'g');
        walkerG.setAttribute('class', 'pl-walk__walker-el');
        const startPt = walkPath.getPointAtLength(0);
        walkerG.setAttribute('transform', `translate(${startPt.x.toFixed(1)},${startPt.y.toFixed(1)})`);
        const halo = document.createElementNS(NS, 'circle');
        halo.setAttribute('r', '14'); halo.setAttribute('fill', 'rgba(176,141,87,0.1)'); halo.setAttribute('stroke', 'none');
        const head = document.createElementNS(NS, 'circle');
        head.setAttribute('cx', '0'); head.setAttribute('cy', '-22'); head.setAttribute('r', '5');
        head.setAttribute('fill', 'var(--tla-gold,#B08D57)');
        const body = document.createElementNS(NS, 'path');
        body.setAttribute('d', 'M0,-17 L0,-6 M-7,-13 L7,-13 M0,-6 L-5,6 M0,-6 L5,6');
        body.setAttribute('stroke', 'var(--tla-gold,#B08D57)');
        body.setAttribute('stroke-width', '2.5'); body.setAttribute('fill', 'none');
        body.setAttribute('stroke-linecap', 'round');
        walkerG.appendChild(halo); walkerG.appendChild(head); walkerG.appendChild(body);
        svgEl.appendChild(walkerG);

        let currentStage = -1;
        let isDragging   = false;

        function getProgressFromX(clientX) {
          const rect = svgEl.getBoundingClientRect();
          const svgW = svgEl.viewBox.baseVal.width;
          const tx   = ((clientX - rect.left) / rect.width) * svgW;
          let lo = 0, hi = 1;
          for (let i = 0; i < 28; i++) {
            const mid = (lo + hi) / 2;
            if (walkPath.getPointAtLength(mid * pathLen).x < tx) lo = mid; else hi = mid;
          }
          return (lo + hi) / 2;
        }

        function applyProgress(t) {
          t = Math.max(0, Math.min(1, t));
          const pt = walkPath.getPointAtLength(t * pathLen);
          walkerG.setAttribute('transform', `translate(${pt.x.toFixed(1)},${pt.y.toFixed(1)})`);
          const stage = stationTs.filter((s) => t > s).length;
          if (stage === currentStage) return;
          currentStage = stage;

          svgEl.querySelectorAll('.walk-station').forEach((el, i) => {
            el.classList.toggle('passed', i < stage);
          });

          const newSrc = keyImgs[Math.min(stage, keyImgs.length - 1)];
          const cur = keyImg.getAttribute('src') || '';
          if (!cur.endsWith(newSrc.split('/').pop())) {
            keyImg.classList.add('fading');
            setTimeout(() => {
              keyImg.src = newSrc;
              keyImg.onload  = () => keyImg.classList.remove('fading');
              keyImg.onerror = () => keyImg.classList.remove('fading');
            }, 160);
          }

          runeEls.forEach((el, i) => {
            if (i < stage && i < 8) {
              if (!el.classList.contains('revealed')) {
                el.textContent = el.dataset.rune || '◌';
                el.classList.add('revealed');
              }
            } else {
              el.textContent = '◌';
              el.classList.remove('revealed');
            }
          });
        }

        applyProgress(0);

        svgEl.addEventListener('mousedown', (e) => { isDragging = true; applyProgress(getProgressFromX(e.clientX)); });
        window.addEventListener('mousemove', (e) => { if (isDragging) applyProgress(getProgressFromX(e.clientX)); });
        window.addEventListener('mouseup',   () => { isDragging = false; });
        svgEl.addEventListener('touchstart', (e) => { isDragging = true; applyProgress(getProgressFromX(e.touches[0].clientX)); e.preventDefault(); }, { passive: false });
        window.addEventListener('touchmove', (e) => { if (isDragging) { applyProgress(getProgressFromX(e.touches[0].clientX)); e.preventDefault(); } }, { passive: false });
        window.addEventListener('touchend',  () => { isDragging = false; });
      })();
    </script>
  </body>
</html>
