---
import "../../styles/homepage.css";
import "../../styles/touchstation.css";
const year = new Date().getFullYear();

/* Internal cost and labour figures. Set to false for the customer-facing version. */
const showCosts = true;

const tiers = [
  {
    id: "instap",
    name: "Instap",
    size: '21,5&quot; Full HD &middot; one app',
    featured: false,
    totalEx: "&euro; 1,620",
    totalIncl: "&euro; 1,960",
    sell: "A pilot, not a compromise. One app you author yourself, running the full platform, so you can find out whether your visitors actually use a touchscreen before spending more.",
    satellite: "&euro; 1,440",
    chips: [
      { k: "Diagonal", v: '21,5&quot;' },
      { k: "Resolution", v: "1920 &times; 1080" },
      { k: "Brightness", v: "215 cd/m&sup2;" },
      { k: "Apps", v: "One, authorable" },
      { k: "Housing", v: "Bracket" },
      { k: "Commissioning", v: "Remote" },
    ],
    parts: "&euro; 548",
    hours: "1",
    labour: "&euro; 80",
    hwLine: "&euro; 870",
    services: "&euro; 500 + &euro; 250",
    bom: [
      { k: "Panel &mdash; iiyama ProLite T2252MSC-B2AG", v: "&euro; 247" },
      { k: "Mini PC &mdash; N100/N150, 16GB, OEM Win 11 Pro", v: "&euro; 200" },
      { k: "VESA bracket", v: "&euro; 35" },
      { k: "Cabling and fixings", v: "&euro; 30" },
      { k: "Freight", v: "&euro; 20" },
      { k: "Subtotal", v: "&euro; 532" },
      { k: "Contingency / DOA 3%", v: "&euro; 16" },
    ],
  },
  {
    id: "station",
    name: "Station",
    size: '27&quot; QHD &middot; on a plinth',
    featured: true,
    totalEx: "&euro; 2,540",
    totalIncl: "&euro; 3,073",
    sell: "Brightness and surface, not pixels. Nearly double the brightness of the Instap and an interface 26% physically larger. Two visitors side by side, readable in a daylit room.",
    satellite: "&euro; 1,970",
    chips: [
      { k: "Diagonal", v: '27&quot;' },
      { k: "Resolution", v: "2560 &times; 1440" },
      { k: "Brightness", v: "400 cd/m&sup2;" },
      { k: "Apps", v: "Full suite" },
      { k: "Housing", v: "Plinth, standard" },
      { k: "Commissioning", v: "8h on site" },
    ],
    parts: "&euro; 766",
    hours: "3",
    labour: "&euro; 240",
    hwLine: "&euro; 1,400",
    services: "&euro; 500 + &euro; 640",
    bom: [
      { k: "Panel &mdash; iiyama ProLite T2755QSC-B1", v: "&euro; 379" },
      { k: "Mini PC &mdash; N100/N150, 16GB, OEM Win 11 Pro", v: "&euro; 200" },
      { k: "Laser-cut plinth with integrated VESA bracket", v: "&euro; 115" },
      { k: "Cabling and fixings", v: "&euro; 30" },
      { k: "Freight", v: "&euro; 20" },
      { k: "Subtotal", v: "&euro; 744" },
      { k: "Contingency / DOA 3%", v: "&euro; 22" },
    ],
  },
  {
    id: "tafel",
    name: "Tafel",
    size: '42,5&quot; 4K &middot; table',
    featured: false,
    totalEx: "&euro; 5,350",
    totalIncl: "&euro; 6,474",
    sell: "The table, never the resolution. Three or four visitors around one object at seated height. Choose this one by the size of the room, not by budget.",
    satellite: "&euro; 4,780",
    chips: [
      { k: "Diagonal", v: '42,5&quot;' },
      { k: "Resolution", v: "3840 &times; 2160" },
      { k: "Brightness", v: "435 cd/m&sup2;" },
      { k: "Orientation", v: "Face-up rated" },
      { k: "Housing", v: "Antique table" },
      { k: "Concurrent use", v: "3&ndash;4" },
    ],
    parts: "&euro; 2,074",
    hours: "12",
    labour: "&euro; 960",
    hwLine: "&euro; 4,210",
    services: "&euro; 500 + &euro; 640",
    bom: [
      { k: "Panel &mdash; iiyama ProLite TF4339AS-B1AG", v: "&euro; 1,125" },
      { k: "Mini PC &mdash; Beelink EQR7, Ryzen 7 7735U", v: "&euro; 344" },
      { k: "Table, glass, subframe, ventilation", v: "&euro; 430" },
      { k: "Cabling and fixings", v: "&euro; 35" },
      { k: "Freight", v: "&euro; 80" },
      { k: "Subtotal", v: "&euro; 2,014" },
      { k: "Contingency / DOA 3%", v: "&euro; 60" },
    ],
  },
  {
    id: "xl",
    name: "Tafel XL",
    size: '55&quot; 4K &middot; large table',
    featured: false,
    totalEx: "&euro; 7,050",
    totalIncl: "&euro; 8,530",
    sell: "Surface and presence. 121,8 &times; 68,5cm of active image &mdash; 1,64&times; the 43&quot; &mdash; with an interface 28% physically larger. The centrepiece, for a room that can take one.",
    satellite: "&euro; 6,480",
    chips: [
      { k: "Diagonal", v: '55&quot;' },
      { k: "Resolution", v: "3840 &times; 2160" },
      { k: "Brightness", v: "500 cd/m&sup2;" },
      { k: "Orientation", v: "Face-up rated" },
      { k: "Housing", v: "Table, 150 &times; 95cm" },
      { k: "Concurrent use", v: "4+" },
    ],
    parts: "&euro; 3,055",
    hours: "15",
    labour: "&euro; 1,200",
    hwLine: "&euro; 5,910",
    services: "&euro; 500 + &euro; 640",
    bom: [
      { k: "Panel &mdash; iiyama ProLite TF5539AS-B1AG", v: "&euro; 1,689" },
      { k: "Mini PC &mdash; Beelink EQR7, Ryzen 7 7735U", v: "&euro; 344" },
      { k: "Table + structural steel subframe", v: "&euro; 360" },
      { k: "Glass &mdash; 4mm toughened low-iron, 1500 &times; 950", v: "&euro; 185" },
      { k: "Cooling &mdash; 3&times; Noctua NF-A14 ULN + PSU", v: "&euro; 93" },
      { k: "Filters and grilles", v: "&euro; 90" },
      { k: "Fixings, gaskets, expansion strip", v: "&euro; 25" },
      { k: "Cabling and fixings", v: "&euro; 40" },
      { k: "Freight &mdash; pallet + table collection", v: "&euro; 140" },
      { k: "Subtotal", v: "&euro; 2,966" },
      { k: "Contingency / DOA 3%", v: "&euro; 89" },
    ],
  },
];

const compare = [
  { k: "Diagonal", v: ['21,5&quot;', '27&quot;', '42,5&quot;', '55&quot;'] },
  { k: "Resolution", v: ["1920 &times; 1080", "2560 &times; 1440", "3840 &times; 2160", "3840 &times; 2160"] },
  { k: "Brightness", v: ["215 cd/m&sup2;", "400 cd/m&sup2;", "435 cd/m&sup2;", "500 cd/m&sup2;"] },
  { k: "Pixel density", v: ["102 PPI", "109 PPI", "104 PPI", "80 PPI"] },
  { k: "Physical size per design pixel", v: ["0,124 mm", "0,156 mm", "0,248 mm", "0,317 mm"] },
  { k: "Orientation", v: ["Upright", "Upright", "Face-up rated", "Face-up rated"] },
  { k: "Housing", v: ["Bracket, plinth optional", "Plinth standard", "Antique table", "Antique table, 150 &times; 95cm"] },
  { k: "Mini PC", v: ["N100/N150, 16 GB", "N100/N150, 16 GB", "Ryzen 7 7735U, 16 GB", "Ryzen 7 7735U, 16 GB"] },
  { k: "Apps included", v: ["One, authorable", "Full suite", "Full suite", "Full suite"] },
  { k: "Concurrent use", v: ["1", "2", "3&ndash;4", "4+"] },
];

const compareInternal = [
  { k: "Hardware cost", v: ["&euro; 548", "&euro; 766", "&euro; 2,074", "&euro; 3,055"] },
  { k: "Build hours", v: ["1 h", "3 h", "12 h", "15 h"] },
  { k: "Labour value at &euro; 80/h", v: ["(&euro; 80)", "(&euro; 240)", "(&euro; 960)", "(&euro; 1,200)"] },
  { k: "At cost &mdash; parts + hours", v: ["&euro; 548 + 1 h", "&euro; 766 + 3 h", "&euro; 2,074 + 12 h", "&euro; 3,055 + 15 h"] },
];

const compareMoney = [
  { k: "Hardware line", v: ["&euro; 870", "&euro; 1,400", "&euro; 4,210", "&euro; 5,910"] },
  { k: "Licence and services", v: ["&euro; 750", "&euro; 1,140", "&euro; 1,140", "&euro; 1,140"] },
  { k: "One station, excl. VAT", v: ["&euro; 1,620", "&euro; 2,540", "&euro; 5,350", "&euro; 7,050"] },
  { k: "One station, incl. VAT", v: ["&euro; 1,960", "&euro; 3,073", "&euro; 6,474", "&euro; 8,530"] },
  { k: "Satellite, same site", v: ["&euro; 1,440", "&euro; 1,970", "&euro; 4,780", "&euro; 6,480"] },
];

const services = [
  { name: "Medelotapps usage licence", what: "Per-site licence to the platform and the pre-built apps, brand application, a configured components.json, the kiosk image and a content-authoring handover. The first machine is included.", price: "&euro; 500" },
  { name: "Additional machine", what: "Every further screen at the same site. No second licence, no repeat engineering.", price: "&euro; 250" },
  { name: "Installation and commissioning", what: "On-site placement, configuration and volunteer handover, 8 hours.", price: "&euro; 640" },
  { name: "Remote commissioning", what: "A guided remote session plus a recorded handover. Instap only.", price: "&euro; 250" },
  { name: "Content integration", what: "We load and lay out your material instead of handing you the tools. Quoted on volume per venue.", price: "from &euro; 800" },
  { name: "Custom app", what: "Built to brief &mdash; such as Pr&ograve;t m&egrave;r M&eacute;&eacute;ls, the dialect trainer for Museum Medelo.", price: "from &euro; 1,600" },
  { name: "Volunteer control box", what: "Three illuminated buttons &mdash; ON / RESTART / OFF &mdash; that anyone opening up on a Tuesday can operate without touching the PC. No mains in the enclosure.", price: "&euro; 120" },
];

const apps = [
  { icon: "&#127968;", caption: "Home screen", note: "Your logo, palette and typography; the apps you choose to show." },
  { icon: "&#128444;&#65039;", caption: "Photo archive", note: "Collection images with descriptions, searchable by keyword." },
  { icon: "&#128506;&#65039;", caption: "Map and timeline", note: "Historical cartography and events laid out on a timeline." },
  { icon: "&#127793;", caption: "Genealogy", note: "People records and family trees from your own export." },
];

const faq = [
  { q: "What exactly do we have to supply?", a: "Your own material &mdash; photographs, films, documents, articles, people records, map material, a genealogy export &mdash; in the supported formats. We supply the framework and the tools to load it. Your volunteers add material themselves; you never wait on us to publish a photograph." },
  { q: "What is the difference between Instap and the rest?", a: "Instap runs one app, which you author yourself, on the same platform as the largest table. It exists so you can test whether a touchscreen earns its place in your venue before committing to a full installation. Upgrading later credits what you have already paid." },
  { q: "Can we start with one screen and add more later?", a: "Yes, and it is the cheapest way to grow. The licence is per site, so a second or third screen costs the hardware plus &euro; 250 for the machine and about four hours of configuration." },
  { q: "Who maintains it once it is installed?", a: "You can, and the handover is built for that. Most venues take the maintenance contract instead: remote monitoring, content updates, one site visit a year and a spare mini PC held in stock." },
  { q: "We have no capital budget.", a: "Most heritage foundations do not, but many have access to subsidy &mdash; Innovatiefonds Noord-Limburg, the Mondriaan Fonds, provincial cultural budgets. We help write the application. That is usually a bigger lever than any hardware discount." },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Touch Station &mdash; The Lions Alliance</title>
    <meta name="description" content="A pre-configured touchscreen station for museums and heritage venues: panel, mini PC, enclosure and a Medelotapps licence. Four fixed tiers, from a single-app pilot to a 55&quot; 4K table." />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" hreflang="en" href="https://thelionsalliance.com/touchscreens/" />
    <link rel="alternate" hreflang="nl" href="https://thelionsalliance.com/touchscreens/nl/" />
    <link rel="alternate" hreflang="x-default" href="https://thelionsalliance.com/touchscreens/" />
  </head>
  <body class="tla-page ts-page">

    <!-- ── Navigation ─────────────────────────────────── -->
    <nav class="tla-nav" id="tla-nav">
      <div class="tla-nav__inner tla-container">
        <a href="/" class="tla-nav__logo">The Lions <span>Alliance</span></a>
        <ul class="tla-nav__links">
          <li><a href="#software">Software</a></li>
          <li><a href="#tiers">Tiers</a></li>
          <li><a href="#compare">Comparison</a></li>
          <li><a href="#services">Services</a></li>
        </ul>
        <div class="tla-nav__actions">
          <a href="/touchscreens/nl/" class="tla-nav__lang" hreflang="nl" lang="nl" title="Bekijk in het Nederlands">NL</a>
          <a href="/contact/" class="tla-nav__cta tla-nav__cta--gold">Contact</a>
          <a href="/" class="tla-nav__cta">&larr; Studio</a>
        </div>
        <button class="tla-nav__hamburger" id="hamburger" aria-label="Toggle menu">
          <span></span><span></span><span></span>
        </button>
      </div>
      <div class="tla-nav__mobile" id="mobile-menu">
        <a href="#software">Software</a>
        <a href="#tiers">Tiers</a>
        <a href="#compare">Comparison</a>
        <a href="#services">Services</a>
        <a href="/contact/">Contact</a>
        <a href="/touchscreens/nl/" hreflang="nl" lang="nl">Bekijk in het Nederlands</a>
        <a href="/">&larr; Back to Studio</a>
      </div>
    </nav>

    <!-- ── Hero ───────────────────────────────────────── -->
    <section class="ts-hero" id="home">
      <div class="tla-container ts-hero__inner">
        <div class="tla-fade">
          <div class="ts-hero__breadcrumb">
            <a href="/">The Lions Alliance</a>
            <span class="ts-hero__sep">/</span>
            <span>Touch Station</span>
          </div>
          <span class="ts-eyebrow">Touchscreen station for heritage</span>
          <h1 class="ts-hero__title">One platform.<br />Four tiers.<br /><em>Your own story.</em></h1>
          <p class="ts-hero__lead">
            A pre-configured touchscreen station for museums and heritage foundations: panel, mini PC, enclosure and a Medelotapps usage licence. Not a bespoke project &mdash; four fixed configurations.
          </p>
          <p class="ts-hero__kicker">We supply the framework. You supply the collection.</p>
          <div class="ts-hero__ctas">
            <a href="#tiers" class="ts-btn ts-btn--gold">See the tiers</a>
            <a href="/contact/" class="ts-btn ts-btn--ghost">Request a quote</a>
          </div>
        </div>
        <div class="ts-hero__card tla-fade tla-d1">
          <div class="ts-hero__card-label">One station, excl. VAT</div>
          <ul class="ts-hero__rows">
            {tiers.map((t) => (
              <li>
                <span set:html={`${t.name} &middot; ${t.size.split("&middot;")[0].trim()}`} />
                <strong set:html={t.totalEx} />
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ── What we sell ───────────────────────────────── -->
    <section class="ts-band ts-band--cream" id="split">
      <div class="tla-container">
        <div class="tla-fade">
          <span class="ts-eyebrow">The commercial shape</span>
          <h2 class="ts-title">The product is the software. The hardware is the <em>delivery</em>.</h2>
          <p class="ts-lead">
            Medelotapps is a kiosk platform of pre-built heritage apps into which your venue loads its own material. That is what makes a second station cheap and a second venue quick. Your volunteers add material themselves &mdash; you never wait on us to publish a photograph.
          </p>
        </div>
        <div class="ts-split">
          <div class="ts-split__col tla-fade">
            <div class="ts-split__label">We deliver</div>
            <ul class="ts-list">
              <li>The platform licence and the pre-built apps</li>
              <li>Brand application &mdash; logo, palette, typography, home screen</li>
              <li>A configured <code>components.json</code> and the kiosk image</li>
              <li>A handover so your own volunteers can add material</li>
              <li>Optional: content integration and custom apps</li>
            </ul>
          </div>
          <div class="ts-split__col tla-fade tla-d1">
            <div class="ts-split__label">You deliver</div>
            <ul class="ts-list">
              <li>Photographs, films and documents</li>
              <li>Articles and people records</li>
              <li>Map material</li>
              <li>A genealogy export</li>
              <li>In the supported formats &mdash; we tell you which</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Software preview ───────────────────────────── -->
    <section class="ts-band ts-band--dark" id="software">
      <div class="tla-container">
        <div class="tla-fade ts-head--center">
          <span class="ts-eyebrow">Medelotapps</span>
          <h2 class="ts-title">The apps that are ready now</h2>
          <p class="ts-lead">
            A selection from the working environment. Structure, navigation and house style are already settled &mdash; your venue loads its own material into them.
          </p>
        </div>
        <div class="ts-apps">
          {apps.map((a, i) => (
            <div class={`ts-app tla-fade${i ? ` tla-d${Math.min(i, 3)}` : ""}`}>
              <div class="ts-app__frame"><span set:html={a.icon} /></div>
              <div class="ts-app__body">
                <div class="ts-app__caption">{a.caption}</div>
                <div class="ts-app__note">{a.note}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Tiers ──────────────────────────────────────── -->
    <section class="ts-band ts-band--deep" id="tiers">
      <div class="tla-container">
        <div class="tla-fade ts-head--center">
          <span class="ts-eyebrow">Four tiers</span>
          <h2 class="ts-title">One size for every room</h2>
          <p class="ts-lead">
            Instap is the pilot you start with. Station stands in the middle of the room and is what we recommend. Tafel and Tafel XL are furniture with a screen in them rather than a monitor on a bracket &mdash; and that choice is about the size of the room, not the budget.
          </p>
        </div>

        <div class="ts-tiers">
          {tiers.map((t, i) => (
            <article class={`ts-tier tla-fade${i ? ` tla-d${Math.min(i, 3)}` : ""}${t.featured ? " ts-tier--featured" : ""}`}>
              {t.featured && <div class="ts-tier__flag">Our recommendation</div>}
              <div class="ts-tier__body">
                <h3 class="ts-tier__name">{t.name}</h3>
                <div class="ts-tier__size" set:html={t.size} />

                <div class="ts-tier__price">
                  <span set:html={t.totalEx} />
                  <small>excl. VAT</small>
                </div>
                <div class="ts-tier__incl" set:html={`${t.totalIncl} incl. VAT`} />

                <ul class="ts-chips">
                  {t.chips.map((c) => (
                    <li><span>{c.k}</span><strong set:html={c.v} /></li>
                  ))}
                </ul>

                <p class="ts-tier__sell"><strong>Sell it on:</strong> <span set:html={t.sell} /></p>

                <div class="ts-tier__sat">
                  <div class="ts-tier__sat-label">Satellite, same site</div>
                  <span set:html={t.satellite} />
                </div>

                {showCosts && (
                  <details class="ts-cost">
                    <summary>Cost and build &mdash; internal</summary>
                    <div class="ts-cost__inner">
                      <ul class="ts-cost__rows">
                        {t.bom.map((b) => (
                          <li><span set:html={b.k} /><strong set:html={b.v} /></li>
                        ))}
                        <li class="is-total"><span>Hardware cost</span><strong set:html={t.parts} /></li>
                      </ul>
                      <div class="ts-cost__hours">
                        Build: <strong>{t.hours} h</strong> <span set:html={`&mdash; labour value ${t.labour}`} /><br />
                        At cost: <strong set:html={`${t.parts} + ${t.hours} h`} />
                      </div>
                      <ul class="ts-cost__rows" style="margin-top:12px;">
                        <li><span>Hardware line on quote</span><strong set:html={t.hwLine} /></li>
                        <li><span>Licence + commissioning</span><strong set:html={t.services} /></li>
                      </ul>
                      <p class="ts-cost__note">
                        Build hours are repeat-build estimates. The first table of any size is a prototype and will run longer.
                      </p>
                    </div>
                  </details>
                )}
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Comparison ─────────────────────────────────── -->
    <section class="ts-band ts-band--cream" id="compare">
      <div class="tla-container">
        <div class="tla-fade ts-head--center">
          <span class="ts-eyebrow">Side by side</span>
          <h2 class="ts-title">What actually differs</h2>
          <p class="ts-lead">
            Brightness, surface area and the physical size of the interface are the real differences. Pixel density is not &mdash; on the tables you are buying surface, not sharpness.
          </p>
        </div>

        <div class="ts-tablewrap tla-fade">
          <table class="ts-table">
            <thead>
              <tr>
                <th scope="col">Specification</th>
                {tiers.map((t) => <th scope="col">{t.name}</th>)}
              </tr>
            </thead>
            <tbody>
              {compare.map((r) => (
                <tr>
                  <th scope="row" set:html={r.k} />
                  {r.v.map((c) => <td set:html={c} />)}
                </tr>
              ))}
              {showCosts && compareInternal.map((r) => (
                <tr class="is-internal">
                  <th scope="row" set:html={r.k} />
                  {r.v.map((c) => <td set:html={c} />)}
                </tr>
              ))}
              {compareMoney.map((r) => (
                <tr class="is-money">
                  <th scope="row" set:html={r.k} />
                  {r.v.map((c) => <td set:html={c} />)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="ts-table__scroll-hint">Scroll sideways to see all four tiers &rarr;</p>
      </div>
    </section>

    <!-- ── Services ───────────────────────────────────── -->
    <section class="ts-band ts-band--deep" id="services">
      <div class="tla-container">
        <div class="tla-fade">
          <span class="ts-eyebrow">Software and services</span>
          <h2 class="ts-title">A licence on a <em>finished</em> platform</h2>
          <p class="ts-lead">
            The engineering is done. You are not buying forty hours of work but access to a working platform. The licence is per site, not per station &mdash; which is the reason to place several screens at once.
          </p>
        </div>

        <div class="ts-services tla-fade">
          {services.map((s) => (
            <div class="ts-service">
              <div class="ts-service__name" set:html={s.name} />
              <div class="ts-service__what" set:html={s.what} />
              <div class="ts-service__price" set:html={s.price} />
            </div>
          ))}
        </div>

        <div class="ts-care tla-fade">
          <div>
            <span class="ts-eyebrow">Maintenance contract</span>
            <h3 class="ts-title" style="font-size:32px;margin-bottom:10px;">Ongoing care</h3>
            <div class="ts-care__price">&euro; 75&ndash;125</div>
            <div class="ts-care__unit">per station, per month</div>
            <p class="ts-care__note">
              Many heritage foundations have no capital budget but do have access to subsidy. We help write the application &mdash; Innovatiefonds Noord-Limburg, the Mondriaan Fonds and provincial cultural budgets.
            </p>
          </div>
          <ul class="ts-list">
            <li>Remote monitoring</li>
            <li>Content updates</li>
            <li>One site visit a year included</li>
            <li>A spare mini PC held in stock</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- ── FAQ ────────────────────────────────────────── -->
    <section class="ts-band ts-band--cream" id="faq">
      <div class="tla-container">
        <div class="tla-fade ts-head--center">
          <span class="ts-eyebrow">FAQ</span>
          <h2 class="ts-title">Questions we get from museums</h2>
        </div>
        <div class="ts-faq">
          {faq.map((f, i) => (
            <div class={`ts-faq__item tla-fade${i ? ` tla-d${Math.min(i, 3)}` : ""}`}>
              <div class="ts-faq__q" set:html={f.q} />
              <div class="ts-faq__a" set:html={f.a} />
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ── Contact CTA ────────────────────────────────── -->
    <section class="ts-band ts-band--dark" id="contact">
      <div class="tla-container ts-cta__inner">
        <div class="tla-fade">
          <span class="ts-eyebrow">Request a quote</span>
          <h2 class="ts-title">Tell us about the room</h2>
          <p class="ts-lead">
            Send us the space, the light and roughly how many screens you have in mind, and you get a quote back with VAT-inclusive totals for the right tier.
          </p>
          <div class="ts-cta__ctas">
            <a href="/contact/" class="ts-btn ts-btn--gold">Get in touch</a>
            <a href="/" class="ts-btn ts-btn--ghost">Explore the studio &rarr;</a>
          </div>
        </div>
        <div class="tla-fade tla-d1">
          <ul class="ts-list">
            <li>A quote with VAT-inclusive final figures</li>
            <li>Advice on size, based on the room and its light</li>
            <li>Help with the subsidy application</li>
          </ul>
        </div>
      </div>
      <p class="ts-note">All amounts excl. VAT unless stated otherwise.</p>
    </section>

    <!-- ── Footer ─────────────────────────────────────── -->
    <footer class="tla-footer">
      <div class="tla-container tla-footer__inner">
        <div class="tla-footer__brand">
          <div class="tla-footer__logo">The Lions Alliance</div>
          <p class="tla-footer__tagline">Creative studio for meaningful projects.</p>
        </div>
        <div class="tla-footer__links">
          <a href="/">Studio</a>
          <a href="#tiers">Tiers</a>
          <a href="#services">Services</a>
          <a href="/contact/">Contact</a>
        </div>
      </div>
      <div class="tla-container tla-footer__bottom">
        <span>&copy; {year} The Lions Alliance. All rights reserved.</span>
        <span>Prices indicative &mdash; verify before quoting.</span>
      </div>
    </footer>

    <!-- ── Scripts ─────────────────────────────────────── -->
    <script>
      const nav = document.getElementById('tla-nav');
      if (nav) {
        window.addEventListener('scroll', () => {
          nav.classList.toggle('scrolled', window.scrollY > 40);
        });
      }
      const faders = document.querySelectorAll('.tla-fade');
      if (faders.length && 'IntersectionObserver' in window) {
        const obs = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('tla-visible');
                obs.unobserve(e.target);
              }
            });
          },
          { threshold: 0.15 }
        );
        faders.forEach((el) => obs.observe(el));
      } else {
        faders.forEach((el) => el.classList.add('tla-visible'));
      }
      const hamburger = document.getElementById('hamburger');
      const mobileMenu = document.getElementById('mobile-menu');
      if (hamburger && mobileMenu) {
        hamburger.addEventListener('click', () => {
          const open = mobileMenu.classList.toggle('open');
          hamburger.classList.toggle('open', open);
          hamburger.setAttribute('aria-expanded', String(open));
        });
        mobileMenu.querySelectorAll('a').forEach((a) => {
          a.addEventListener('click', () => {
            mobileMenu.classList.remove('open');
            hamburger.classList.remove('open');
            hamburger.setAttribute('aria-expanded', 'false');
          });
        });
      }
    </script>
  </body>
</html>
