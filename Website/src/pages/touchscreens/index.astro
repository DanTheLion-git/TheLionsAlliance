                  <th scope="row" set:html={r.k} />
                  {r.v.map((c) => <td set:html={c} />)}
                </tr>
              ))}
              {showCosts && compareInternal.map((r) => (
                <tr class="is-internal">
                  <th scope="row" set:html={r.k} />
                  {r.v.map((c) => <td set:html={c} />)}
                </tr>
              ))}
              {compareMoney.map((r) => (
                <tr class="is-money">
                  <th scope="row" set:html={r.k} />
                  {r.v.map((c) => <td set:html={c} />)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="ts-table__scroll-hint">Scroll sideways to see all four tiers &rarr;</p>
        <p class="ts-note">Starting prices, September 2026, excluding VAT unless stated otherwise. The technology line follows the current hardware price; the licence, the build and installation are fixed. A quote is valid for 30 days.</p>
      </div>
    </section>

    <!-- ── Services ───────────────────────────────────── -->
    <section class="ts-section ts-section--alt" id="services">
      <div class="tla-container">
        <div class="tla-section-header tla-fade">
          <span class="tla-overline">Software and services</span>
          <h2>A licence on a finished platform</h2>
          <p>
            The engineering is done. You are not buying forty hours of work but access to a working platform. The licence is per site, not per station &mdash; which is the reason to place several screens at once.
          </p>
        </div>

        <div class="ts-services tla-fade">
