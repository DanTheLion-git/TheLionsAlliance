    ownHwIncl: "&euro; 5,348",
    ownTableEx: "from &euro; 6,550",
    ownTableIncl: "from &euro; 7,926",
    lines: [
      { k: "Technology &mdash; 55&quot; 4K panel, mini PC, cabling, freight", v: "approx. &euro; 2,930" },
