      { k: "Installation and commissioning", v: "&euro; 640" },
    ],
    parts: "&euro; 3,055",
    hours: "23",
    labour: "&euro; 2,185",
    hwLine: "&euro; 2,880 + &euro; 2,180",
    services: "&euro; 1,250 + &euro; 640",
    bom: [
      { k: "Panel &mdash; iiyama ProLite TF5539AS-B1AG", v: "&euro; 1,689" },
      { k: "Mini PC &mdash; Beelink EQR7, Ryzen 7 7735U", v: "&euro; 344" },
      { k: "Table + structural steel subframe", v: "&euro; 360" },
      { k: "Glass &mdash; 4mm toughened low-iron, 1500 &times; 950", v: "&euro; 185" },
      { k: "Cooling &mdash; 3&times; Noctua NF-A14 ULN + PSU", v: "&euro; 93" },
      { k: "Filters and grilles", v: "&euro; 90" },
      { k: "Fixings, gaskets, expansion strip", v: "&euro; 25" },
      { k: "Cabling and fixings", v: "&euro; 40" },
      { k: "Freight &mdash; pallet + table collection", v: "&euro; 140" },
      { k: "Subtotal", v: "&euro; 2,966" },
      { k: "Contingency / DOA 3%", v: "&euro; 89" },
    ],
  },
];

const compare = [
  { k: "Diagonal", v: ['21,5&quot;', '27&quot;', '42,5&quot;', '55&quot;'] },
  { k: "Resolution", v: ["1920 &times; 1080", "2560 &times; 1440", "3840 &times; 2160", "3840 &times; 2160"] },
  { k: "Brightness", v: ["215 cd/m&sup2;", "400 cd/m&sup2;", "435 cd/m&sup2;", "500 cd/m&sup2;"] },
  { k: "Pixel density", v: ["102 PPI", "109 PPI", "104 PPI", "80 PPI"] },
  { k: "Physical size per design pixel", v: ["0,124 mm", "0,156 mm", "0,248 mm", "0,317 mm"] },
  { k: "Orientation", v: ["Upright", "Upright", "Face-up rated", "Face-up rated"] },
  { k: "Housing", v: ["Bracket, floor stand optional", "Floor stand, lectern optional", "Antique table", "Antique table, 150 &times; 95cm"] },
  { k: "Mini PC", v: ["N100/N150, 16 GB", "N100/N150, 16 GB", "Ryzen 7 7735U, 16 GB", "Ryzen 7 7735U, 16 GB"] },
  { k: "Apps included", v: ["One, authorable", "Full suite", "Full suite", "Full suite"] },
  { k: "Concurrent use", v: ["1", "2", "3&ndash;4", "4+"] },
];

const compareInternal = [
  { k: "Parts cost", v: ["&euro; 548", "&euro; 831", "&euro; 2,074", "&euro; 3,055"] },
  { k: "&mdash; of which technology", v: ["&euro; 548", "&euro; 651", "&euro; 1,644", "&euro; 2,302"] },
  { k: "&mdash; of which fabrication materials", v: ["&mdash;", "&euro; 180", "&euro; 430", "&euro; 753"] },
  { k: "Fabrication hours at &euro; 95/h", v: ["&mdash;", "1,5 h", "12 h", "15 h"] },
  { k: "Hours incl. commissioning", v: ["3 h", "9,5 h", "20 h", "23 h"] },
  { k: "Return per hour, whole job", v: ["&euro; 379", "&euro; 231", "&euro; 172", "&euro; 169"] },
  { k: "First build &mdash; hours / per hour", v: ["&mdash;", "&mdash;", "32 h / &euro; 108", "38 h / &euro; 102"] },
];

const compareMoney = [
  { k: "Technology", v: ["approx. &euro; 700", "approx. &euro; 835", "approx. &euro; 2,090", "approx. &euro; 2,930"] },
  { k: "Housing and fabrication", v: ["&mdash;", "&euro; 325", "&euro; 1,570", "&euro; 2,180"] },
  { k: "Licence and services", v: ["&euro; 1,000", "&euro; 1,890", "&euro; 1,890", "&euro; 1,890"] },
  { k: "One station, excl. VAT", v: ["from &euro; 1,700", "from &euro; 3,050", "from &euro; 5,550", "from &euro; 7,000"] },
  { k: "One station, incl. VAT", v: ["from &euro; 2,057", "from &euro; 3,691", "from &euro; 6,716", "from &euro; 8,470"] },
  { k: "With your own hardware, incl. VAT", v: ["&euro; 1,634", "&euro; 3,104", "&euro; 4,610", "&euro; 5,348"] },
  { k: "Satellite, same site", v: ["from &euro; 1,430", "from &euro; 1,890", "from &euro; 4,390", "from &euro; 5,840"] },
];

const services = [
  { name: "Medelotapps usage licence", what: "Per-site licence to the platform and the pre-built apps, brand application, a configured components.json, the kiosk image and a content-authoring handover. The first machine is included.", price: "&euro; 1,250" },
  { name: "Starter licence", what: "The same platform running one app, which you author yourself. Instap only. Upgrading within twelve months credits it in full against the licence above.", price: "&euro; 750" },
  { name: "Additional machine", what: "Every further screen at the same site. No second licence, no repeat engineering.", price: "&euro; 350" },
  { name: "Installation and commissioning", what: "On-site placement, configuration and volunteer handover, 8 hours. A capped figure, not a meter.", price: "&euro; 640" },
  { name: "Remote commissioning", what: "A guided remote session plus a recorded handover. Instap only.", price: "&euro; 250" },
  { name: "Integration with your own hardware", what: "You buy the panel and the mini PC yourself, on our exact part list. We advise on the list, then configure and integrate.", price: "&euro; 350" },
  { name: "Content integration", what: "We load and lay out your material instead of handing you the tools. Quoted on volume per venue.", price: "from &euro; 800" },
  { name: "Custom app", what: "Built to brief &mdash; such as Pr&ograve;t m&egrave;r M&eacute;&eacute;ls, the dialect trainer for Museum Medelo.", price: "from &euro; 1,600" },
  { name: "Custom lectern", what: "A birch-plywood lectern built to order around the 27&quot; Station: weighted base, screen set into a sloped top, service door, ventilation. Replaces the floor stand.", price: "+ &euro; 775" },
  { name: "Floor fixing", what: "Anchoring any station to the floor. We recommend it wherever children use it unsupervised.", price: "&euro; 60" },
  { name: "Volunteer control box", what: "Three illuminated buttons &mdash; ON / RESTART / OFF &mdash; that anyone opening up on a Tuesday can operate without touching the PC. No mains in the enclosure.", price: "&euro; 120" },
];

const faq = [
  { q: "What exactly do we have to supply?", a: "Your own material &mdash; photographs, films, documents, articles, people records, map material, a genealogy export &mdash; in the supported formats. We supply the framework and the tools to load it. Your volunteers add material themselves; you never wait on us to publish a photograph." },
  { q: "What is the difference between Instap and the rest?", a: "Instap runs one app, which you author yourself, on the same platform as the largest table. It exists so you can test whether a touchscreen earns its place in your venue before committing to a full installation. Upgrading later credits what you have already paid." },
  { q: "Can we start with one screen and add more later?", a: "Yes, and it is the cheapest way to grow. The licence is per site, so a second or third screen costs the hardware plus &euro; 350 for the machine and about four hours of configuration." },
  { q: "Why is the table more expensive than the screen in it?", a: "Because most of that line is work, not parts, and we would rather show you than bury it. A table is sourced, measured, cut, given a steel subframe, ventilated, glazed and tested &mdash; and the quote says so on its own line. You are paying for a piece of furniture that belongs in your building, built by hand, rather than a grey cabinet that arrives on a pallet." },
  { q: "Can we buy the screen and the computer ourselves?", a: "Yes, and for many venues it is the easier purchase. We give you the exact part list, you buy it &mdash; or have it sponsored or donated, which happens often &mdash; and we charge &euro; 350 to advise, configure and integrate. You own the hardware and deal with its warranty directly. It takes roughly &euro; 2,000 off a table quote and costs us almost nothing, because our margin was never in the box." },
  { q: "Who maintains it once it is installed?", a: "You can, and the handover is built for that. Most venues take the maintenance contract instead: remote monitoring, content updates, one site visit a year and a spare mini PC held in stock." },
  { q: "We have no capital budget.", a: "Most heritage foundations do not, but many have access to subsidy &mdash; Innovatiefonds Noord-Limburg, the Mondriaan Fonds, provincial cultural budgets. We help write the application. That is usually a bigger lever than any hardware discount." },
];

/* Drawings per tier. Station has two: the standard floor stand and the optional lectern. */
const art = {
  instap: [{ src: "/images/touch-tafel/tier-instap.webp", alt: "Instap: a 21.5-inch touchscreen on a desk stand" }],
  station: [
    { src: "/images/touch-tafel/tier-station-1.webp", alt: "Station: a 27-inch touchscreen on a steel floor stand with a weighted foot plate", label: "Floor stand" },
    { src: "/images/touch-tafel/tier-station-2.webp", alt: "Station in the optional custom lectern, screen set into a sloped top", label: "Lectern" },
  ],
  tafel: [{ src: "/images/touch-tafel/tier-tafel.webp", alt: "Tafel: a 43-inch screen set flush into an antique table under glass" }],
  xl: [{ src: "/images/touch-tafel/tier-tafelxl.webp", alt: "Tafel XL: a 55-inch screen set into a 150 by 95 cm table" }],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Touch Station &mdash; The Lions Alliance</title>
    <meta name="description" content="A pre-configured touchscreen station for museums and heritage venues: panel, mini PC, enclosure and a Medelotapps licence. Four fixed tiers, from a single-app pilot to a 55&quot; 4K table." />
    <link rel="icon" type="image/png" href="/favicon-logo.png" />
    <link rel="alternate" hreflang="en" href="https://thelionsalliance.com/touchscreens/" />
    <link rel="alternate" hreflang="nl" href="https://thelionsalliance.com/touchscreens/nl/" />
    <link rel="alternate" hreflang="x-default" href="https://thelionsalliance.com/touchscreens/" />
  </head>
  <body class="tla-page pl-body">

    <!-- ── Navigation ─────────────────────────────────── -->
    <nav class="tla-nav" id="tla-nav">
      <div class="tla-nav__inner tla-container">
        <a href="/" class="tla-nav__logo"><img src="/images/branding/lions-logo.webp" alt="" class="tla-nav__logo-img" />The Lions <span>Alliance</span></a>
        <ul class="tla-nav__links">
          <li><a href="#software">Software</a></li>
          <li><a href="#tiers">Tiers</a></li>
          <li><a href="#variants">Budget</a></li>
          <li><a href="#compare">Comparison</a></li>
          <li><a href="#services">Services</a></li>
        </ul>
        <div class="tla-nav__actions">
          <a href="/touchscreens/nl/" class="tla-nav__lang" hreflang="nl" lang="nl" title="Bekijk in het Nederlands">NL</a>
          <a href="/contact/" class="tla-nav__cta tla-nav__cta--gold">Contact</a>
          <a href="/" class="tla-nav__cta">&larr; Studio</a>
        </div>
        <button class="tla-nav__hamburger" id="hamburger" aria-label="Toggle menu">
          <span></span><span></span><span></span>
        </button>
      </div>
      <div class="tla-nav__mobile" id="mobile-menu">
        <a href="#software">Software</a>
        <a href="#tiers">Tiers</a>
        <a href="#variants">Budget</a>
        <a href="#compare">Comparison</a>
        <a href="#services">Services</a>
        <a href="/contact/">Contact</a>
        <a href="/touchscreens/nl/" hreflang="nl" lang="nl">Bekijk in het Nederlands</a>
        <a href="/">&larr; Back to Studio</a>
      </div>
    </nav>

    <!-- ── Hero ───────────────────────────────────────── -->
    <section class="pl-hero" id="home">
      <div class="tla-container pl-hero__inner">
        <div class="pl-hero__text tla-fade">
          <div class="pl-hero__breadcrumb">
            <a href="/">The Lions Alliance</a>
            <span class="pl-hero__breadcrumb-sep">/</span>
            <span>Touch Station</span>
          </div>
          <div class="pl-hero__badges">
            <span class="tla-badge tla-badge--live">Live at Museum Medelo &mdash; shown 20 Sept 2026</span>
          </div>
          <h1 class="pl-hero__title">One platform.<br />Four tiers.<br /><em>Your own story.</em></h1>
          <p class="pl-hero__subtitle">
            A pre-configured touchscreen station for museums and heritage foundations: panel, mini PC, enclosure and a Medelotapps usage licence. Not a bespoke project &mdash; four fixed configurations. We supply the framework; you supply the collection.
          </p>
          <div class="pl-hero__ctas">
            <a href="#tiers" class="tla-btn tla-btn--sage">See the tiers</a>
            <a href="/contact/" class="tla-btn tla-btn--outline">Request a quote</a>
          </div>
        </div>
        <div class="pl-hero__visual tla-fade tla-d1">
          <div class="ts-pricecard">
            <span class="ts-label">One station, excl. VAT</span>
            <ul class="ts-pricecard__rows">
              {tiers.map((t) => (
                <li>
                  <span set:html={`${t.name} &middot; ${t.size.split("&middot;")[0].trim()}`} />
                  <strong set:html={t.totalEx} />
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ── What we sell ───────────────────────────────── -->
    <section class="ts-section ts-section--white" id="split">
      <div class="tla-container">
        <div class="tla-section-header tla-fade">
          <span class="tla-overline">The commercial shape</span>
          <h2>The product is the software. The hardware is the delivery.</h2>
          <p>
            Medelotapps is a kiosk platform of pre-built heritage apps into which your venue loads its own material. That is what makes a second station cheap and a second venue quick. Your volunteers add material themselves &mdash; you never wait on us to publish a photograph. The platform itself is finished: the first two machines &mdash; a touch table and a schoolbord &mdash; are already running at Museum Medelo, shown live to the public at the museum&rsquo;s members-only opening on 20 September 2026.
          </p>
        </div>
        <div class="ts-photos tla-fade">
          <img src="/images/touch-tafel/IMG20260920161431.webp" alt="The Medelotapps touch table running at Museum Medelo" loading="lazy" />
          <img src="/images/touch-tafel/IMG20260920161454.webp" alt="The Medelo Schoolbord screen running at Museum Medelo" loading="lazy" />
        </div>
        <div class="ts-split">
          <div class="ts-split__col tla-fade">
            <span class="ts-label">We deliver</span>
            <ul class="pl-audience-list">
              <li class="pl-audience-item"><span class="pl-audience-dot"></span>The platform licence and the pre-built apps</li>
              <li class="pl-audience-item"><span class="pl-audience-dot"></span>Brand application &mdash; logo, palette, typography, home screen</li>
              <li class="pl-audience-item"><span class="pl-audience-dot"></span>A configured <code>components.json</code> and the kiosk image</li>
              <li class="pl-audience-item"><span class="pl-audience-dot"></span>A handover so your own volunteers can add material</li>
              <li class="pl-audience-item"><span class="pl-audience-dot"></span>Optional: content integration and custom apps</li>
            </ul>
          </div>
          <div class="ts-split__col tla-fade tla-d1">
            <span class="ts-label">You deliver</span>
            <ul class="pl-audience-list">
              <li class="pl-audience-item"><span class="pl-audience-dot"></span>Photographs, films and documents</li>
              <li class="pl-audience-item"><span class="pl-audience-dot"></span>Articles and people records</li>
              <li class="pl-audience-item"><span class="pl-audience-dot"></span>Map material</li>
              <li class="pl-audience-item"><span class="pl-audience-dot"></span>A genealogy export</li>
              <li class="pl-audience-item"><span class="pl-audience-dot"></span>In the supported formats &mdash; we tell you which</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Software preview ───────────────────────────── -->
    <section class="ts-section ts-section--alt" id="software">
      <div class="tla-container">
        <div class="tla-section-header tla-fade">
          <span class="tla-overline">Medelotapps</span>
          <h2>The apps that are ready now &mdash; try them</h2>
          <p>
            This is not a video of the product. It is the product: the same code that runs the table at Museum Medelo, in your browser, loaded with material that belongs to nobody in particular. Pick up a photograph and move it. Drag the map through two centuries. Switch the language.
          </p>
        </div>

        <div class="ts-demo tla-fade" id="demo">
          <div class="ts-demo__stage" id="demo-stage" data-src="/medelotapps-demo/index.html">
            <img class="ts-demo__poster" src="/images/touch-tafel/demo-poster.webp" alt="The Medelotapps home screen" loading="lazy" width="1600" height="900" />
            <button class="ts-demo__launch" type="button" id="demo-launch" aria-describedby="demo-note">
              <span class="ts-demo__play" aria-hidden="true">&#9654;</span>
              <span class="ts-demo__launch-text">Try the demo</span>
              <span class="ts-demo__launch-sub">Nothing loads until you ask &middot; best with a mouse or a touchscreen</span>
            </button>
          </div>
          <div class="ts-demo__bar">
            <p class="ts-demo__note" id="demo-note">
              Ten monarchs, ten moments of world history, forty archive photographs, five places in Amsterdam and three films &mdash; standing in for a venue's own collection. <strong>None of Museum Medelo's material is in here.</strong> The films are National Geographic's, shown through YouTube.
            </p>
            <div class="ts-demo__actions">
              <button class="tla-btn tla-btn--outline tla-btn--sm" type="button" id="demo-full" hidden>Fullscreen</button>
              <a class="tla-btn tla-btn--outline tla-btn--sm" href="/medelotapps-demo/index.html" target="_blank" rel="noopener">Open in a new tab &#8599;</a>
            </div>
          </div>
        </div>
      </div>
