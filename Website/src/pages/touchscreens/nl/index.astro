<script>
      // Station card: switch the drawing between floor stand and lectern.
      document.querySelectorAll('.ts-tier__art').forEach((fig) => {
        const imgs = fig.querySelectorAll('img');
        const btns = fig.querySelectorAll('.ts-tier__switch button');
        btns.forEach((b, i) => b.addEventListener('click', () => {
          imgs.forEach((im, j) => { im.hidden = j !== i; });
          btns.forEach((o, j) => o.setAttribute('aria-pressed', String(j === i)));
        }));
      });
      /* De demo is een paar megabyte aan code, foto's en kaarttegels. Er wordt
         niets opgehaald tot iemand erom vraagt: vandaar de stilstaande plaat
         en een iframe dat pas hier ontstaat. */
      const demoStage = document.getElementById('demo-stage');
      const demoLaunch = document.getElementById('demo-launch');
      const demoFull = document.getElementById('demo-full');
      if (demoStage && demoLaunch) {
        demoLaunch.addEventListener('click', () => {
          const frame = document.createElement('iframe');
          frame.className = 'ts-demo__frame';
          frame.src = demoStage.dataset.src;
          frame.title = 'Medelotapps-demo';
          frame.loading = 'eager';
          frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
          frame.setAttribute('allowfullscreen', '');
          demoStage.appendChild(frame);
          demoStage.classList.add('is-live');
          if (demoFull && demoStage.requestFullscreen) demoFull.hidden = false;
        }, { once: true });
      }
      if (demoFull && demoStage) {
        demoFull.addEventListener('click', () => {
          if (document.fullscreenElement) document.exitFullscreen();
          else demoStage.requestFullscreen && demoStage.requestFullscreen();
        });
      }
    </script>
