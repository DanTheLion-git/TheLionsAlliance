  { k: "Diagonaal", v: ['21,5&quot;', '27&quot;', '42,5&quot;', '55&quot;'] },
  { k: "Resolutie", v: ["1920 &times; 1080", "2560 &times; 1440", "3840 &times; 2160", "3840 &times; 2160"] },
  { k: "Helderheid", v: ["215 cd/m&sup2;", "400 cd/m&sup2;", "435 cd/m&sup2;", "500 cd/m&sup2;"] },
  { k: "Pixeldichtheid", v: ["102 PPI", "109 PPI", "104 PPI", "80 PPI"] },
  { k: "Fysieke maat per design-pixel", v: ["0,124 mm", "0,156 mm", "0,248 mm", "0,317 mm"] },
  { k: "Ori&euml;ntatie", v: ["Staand", "Staand", "Face-up gekeurd", "Face-up gekeurd"] },
  { k: "Behuizing", v: ["Beugel, vloerstatief optioneel", "Vloerstatief, lessenaar optioneel", "Antieke tafel", "Antieke tafel, 150 &times; 95 cm"] },
  { k: "Mini-pc", v: ["N100/N150, 16 GB", "N100/N150, 16 GB", "Ryzen 7 7735U, 16 GB", "Ryzen 7 7735U, 16 GB"] },
  { k: "Apps inbegrepen", v: ["E&eacute;n, zelf te vullen", "Volledige set", "Volledige set", "Volledige set"] },
  { k: "Gelijktijdig gebruik", v: ["1", "2", "3&ndash;4", "4+"] },
];

const compareInternal = [
  { k: "Onderdelenkostprijs", v: ["&euro; 548", "&euro; 831", "&euro; 2.074", "&euro; 3.055"] },
  { k: "&mdash; waarvan techniek", v: ["&euro; 548", "&euro; 651", "&euro; 1.644", "&euro; 2.302"] },
  { k: "&mdash; waarvan fabricagematerialen", v: ["&mdash;", "&euro; 180", "&euro; 430", "&euro; 753"] },
  { k: "Fabricage-uren &agrave; &euro; 95/uur", v: ["&mdash;", "1,5 uur", "12 uur", "15 uur"] },
  { k: "Uren incl. inbedrijfstelling", v: ["3 uur", "9,5 uur", "20 uur", "23 uur"] },
  { k: "Opbrengst per uur, hele opdracht", v: ["&euro; 379", "&euro; 231", "&euro; 172", "&euro; 169"] },
  { k: "Eerste bouw &mdash; uren / per uur", v: ["&mdash;", "&mdash;", "32 uur / &euro; 108", "38 uur / &euro; 102"] },
];

const compareMoney = [
  { k: "Techniek", v: ["&euro; 685", "&euro; 815", "&euro; 2.055", "&euro; 2.880"] },
  { k: "Behuizing en fabricage", v: ["&mdash;", "&euro; 325", "&euro; 1.570", "&euro; 2.180"] },
  { k: "Licentie en diensten", v: ["&euro; 1.000", "&euro; 1.890", "&euro; 1.890", "&euro; 1.890"] },
  { k: "E&eacute;n station, excl. btw", v: ["&euro; 1.685", "&euro; 3.030", "&euro; 5.515", "&euro; 6.950"] },
  { k: "E&eacute;n station, incl. btw", v: ["&euro; 2.039", "&euro; 3.666", "&euro; 6.673", "&euro; 8.410"] },
  { k: "Met eigen hardware, incl. btw", v: ["&euro; 1.634", "&euro; 3.104", "&euro; 4.610", "&euro; 5.348"] },
  { k: "Satelliet, zelfde locatie", v: ["&euro; 1.415", "&euro; 1.870", "&euro; 4.355", "&euro; 5.790"] },
];

const services = [
  { name: "Medelotapps gebruikslicentie", what: "Licentie per locatie op het platform en de vooraf gebouwde apps, huisstijltoepassing, een geconfigureerde components.json, het kiosk-image en contentoverdracht. De eerste machine is inbegrepen.", price: "&euro; 1.250" },
  { name: "Instaplicentie", what: "Hetzelfde platform met &eacute;&eacute;n app, die u zelf vult. Alleen bij Instap. Opwaarderen binnen twaalf maanden verrekent dit bedrag volledig met de licentie hierboven.", price: "&euro; 750" },
  { name: "Extra machine", what: "Elk volgend scherm op dezelfde locatie. Geen tweede licentie, geen herhaald ontwikkelwerk.", price: "&euro; 350" },
  { name: "Installatie en inbedrijfstelling", what: "Plaatsing, configuratie en vrijwilligersoverdracht op locatie, 8 uur. Een vast bedrag, geen lopende teller.", price: "&euro; 640" },
  { name: "Inbedrijfstelling op afstand", what: "Begeleide sessie op afstand plus een opgenomen overdracht. Alleen bij Instap.", price: "&euro; 250" },
  { name: "Integratie bij eigen hardware", what: "U koopt het paneel en de mini-pc zelf, op onze exacte inkooplijst. Wij adviseren over die lijst en verzorgen configuratie en integratie.", price: "&euro; 350" },
  { name: "Contentintegratie", what: "Wij laden en vormgeven uw materiaal in plaats van u het gereedschap te geven. Op volume per locatie.", price: "vanaf &euro; 800" },
  { name: "App op maat", what: "Gebouwd naar briefing &mdash; zoals Pr&ograve;t m&egrave;r M&eacute;&eacute;ls, de dialecttrainer voor Museum Medelo.", price: "vanaf &euro; 1.600" },
  { name: "Lessenaar op maat", what: "Een lessenaar van berkenmultiplex, op bestelling gebouwd rond het 27&quot;-Station: verzwaarde voet, scherm verzonken in een schuin blad, servicedeur, ventilatie. Vervangt het vloerstatief.", price: "+ &euro; 775" },
  { name: "Vloerbevestiging", what: "Het station vastzetten aan de vloer. Wij raden het aan overal waar kinderen zonder toezicht komen.", price: "&euro; 60" },
  { name: "Vrijwilligersbox", what: "Drie verlichte knoppen &mdash; AAN / OPSTARTEN / UIT &mdash; die een vrijwilliger op dinsdagmorgen kan bedienen zonder de pc aan te raken. Geen netspanning in de kast.", price: "&euro; 120" },
];

const faq = [
  { q: "Wat moeten wij precies aanleveren?", a: "Uw eigen materiaal &mdash; foto&rsquo;s, films, documenten, artikelen, personenrecords, kaartmateriaal en een genealogie-export &mdash; in de ondersteunde formaten. Wij leveren het raamwerk en het gereedschap om het te laden. Uw vrijwilligers voegen zelf materiaal toe; u wacht nooit op ons om een foto te publiceren." },
  { q: "Wat is het verschil tussen Instap en de rest?", a: "Instap draait &eacute;&eacute;n app, die u zelf vult, op hetzelfde platform als de grootste tafel. De uitvoering bestaat zodat u kunt toetsen of een touchscreen zijn plaats in uw museum verdient v&oacute;&oacute;r u aan een volledige opstelling begint. Later opwaarderen verrekent wat u al betaalde." },
  { q: "Kunnen wij met &eacute;&eacute;n scherm beginnen en later uitbreiden?", a: "Ja, en het is de voordeligste manier om te groeien. De licentie geldt per locatie, dus een tweede of derde scherm kost de hardware plus &euro; 350 voor de machine en ongeveer vier uur configuratie." },
  { q: "Waarom is de tafel duurder dan het scherm dat erin zit?", a: "Omdat die regel grotendeels uit werk bestaat en niet uit onderdelen &mdash; en wij laten dat liever zien dan dat we het wegmoffelen. Een tafel wordt gezocht, ingemeten, uitgezaagd, voorzien van een staalframe, geventileerd, beglaasd en getest; de opgave zegt dat op een eigen regel. U betaalt voor een meubel dat in uw gebouw thuishoort en met de hand is gebouwd, niet voor een grijze kast die op een pallet arriveert." },
  { q: "Kunnen wij het scherm en de computer zelf kopen?", a: "Ja, en voor veel locaties is dat de eenvoudigste aankoop. U krijgt onze exacte inkooplijst, u koopt de onderdelen &mdash; of laat ze sponsoren of schenken, wat vaker gebeurt dan u denkt &mdash; en wij rekenen &euro; 350 voor advies, configuratie en integratie. De hardware en de garantie staan op uw naam. Het scheelt ruwweg &euro; 2.000 op een tafelopgave en kost ons nauwelijks iets, omdat onze marge nooit in de doos zat." },
  { q: "Wie beheert het na de installatie?", a: "Dat kunt u zelf; de overdracht is daarop ingericht. De meeste locaties kiezen toch het onderhoudscontract: monitoring op afstand, contentupdates, &eacute;&eacute;n bezoek per jaar en een reserve mini-pc op voorraad." },
  { q: "Wij hebben geen investeringsbudget.", a: "De meeste erfgoedstichtingen niet, maar veel hebben wel toegang tot subsidie &mdash; Innovatiefonds Noord-Limburg, het Mondriaan Fonds en provinciale culturele budgetten. Wij helpen de aanvraag schrijven. Dat levert doorgaans meer op dan welke hardwarekorting ook." },
];

/* Tekeningen per tier. Station heeft er twee: het standaard vloerstatief en de optionele lessenaar. */
const art = {
  instap: [{ src: "/images/touch-tafel/tier-instap.webp", alt: "Instap: een 21,5-inch touchscreen op een bureaustandaard" }],
  station: [
    { src: "/images/touch-tafel/tier-station-1.webp", alt: "Station: een 27-inch touchscreen op een stalen vloerstatief met verzwaarde voetplaat", label: "Vloerstatief" },
    { src: "/images/touch-tafel/tier-station-2.webp", alt: "Station in de optionele lessenaar op maat, scherm verzonken in een schuin blad", label: "Lessenaar" },
  ],
  tafel: [{ src: "/images/touch-tafel/tier-tafel.webp", alt: "Tafel: een 43-inch scherm vlak ingebouwd in een antieke tafel onder glas" }],
  xl: [{ src: "/images/touch-tafel/tier-tafelxl.webp", alt: "Tafel XL: een 55-inch scherm ingebouwd in een tafel van 150 bij 95 cm" }],
};
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Touch Station &mdash; The Lions Alliance</title>
    <meta name="description" content="Een vooraf geconfigureerd touchscreen-station voor musea en erfgoedlocaties: paneel, mini-pc, behuizing en een Medelotapps-licentie. Vier vaste uitvoeringen, van proefopstelling tot 55&quot; 4K-tafel." />
    <link rel="icon" type="image/png" href="/favicon-logo.png" />
    <link rel="alternate" hreflang="en" href="https://thelionsalliance.com/touchscreens/" />
    <link rel="alternate" hreflang="nl" href="https://thelionsalliance.com/touchscreens/nl/" />
    <link rel="alternate" hreflang="x-default" href="https://thelionsalliance.com/touchscreens/" />
  </head>
  <body class="tla-page pl-body">

    <!-- ── Navigatie ──────────────────────────────────── -->
    <nav class="tla-nav" id="tla-nav">
      <div class="tla-nav__inner tla-container">
        <a href="/nl/" class="tla-nav__logo"><img src="/images/branding/lions-logo.webp" alt="" class="tla-nav__logo-img" />The Lions <span>Alliance</span></a>
        <ul class="tla-nav__links">
          <li><a href="#software">Software</a></li>
          <li><a href="#tiers">Uitvoeringen</a></li>
          <li><a href="#variants">Budget</a></li>
          <li><a href="#compare">Vergelijking</a></li>
          <li><a href="#services">Diensten</a></li>
        </ul>
        <div class="tla-nav__actions">
          <a href="/touchscreens/" class="tla-nav__lang" hreflang="en" lang="en" title="View in English">EN</a>
          <a href="/contact/nl/" class="tla-nav__cta tla-nav__cta--gold">Contact</a>
          <a href="/nl/" class="tla-nav__cta">&larr; Studio</a>
        </div>
        <button class="tla-nav__hamburger" id="hamburger" aria-label="Menu openen">
          <span></span><span></span><span></span>
        </button>
      </div>
      <div class="tla-nav__mobile" id="mobile-menu">
        <a href="#software">Software</a>
        <a href="#tiers">Uitvoeringen</a>
        <a href="#variants">Budget</a>
        <a href="#compare">Vergelijking</a>
        <a href="#services">Diensten</a>
        <a href="/contact/nl/">Contact</a>
        <a href="/touchscreens/" hreflang="en" lang="en">View in English</a>
        <a href="/nl/">&larr; Terug naar de studio</a>
      </div>
    </nav>

    <!-- ── Hero ───────────────────────────────────────── -->
    <section class="pl-hero" id="home">
      <div class="tla-container pl-hero__inner">
        <div class="pl-hero__text tla-fade">
          <div class="pl-hero__breadcrumb">
            <a href="/nl/">The Lions Alliance</a>
            <span class="pl-hero__breadcrumb-sep">/</span>
            <span>Touch Station</span>
          </div>
          <div class="pl-hero__badges">
            <span class="tla-badge tla-badge--live">Live bij Museum Medelo &mdash; getoond 20 sept 2026</span>
          </div>
          <h1 class="pl-hero__title">E&eacute;n platform.<br />Vier uitvoeringen.<br /><em>Uw eigen verhaal.</em></h1>
          <p class="pl-hero__subtitle">
            Een vooraf geconfigureerd touchscreen-station voor musea en erfgoedstichtingen: paneel, mini-pc, behuizing en een Medelotapps-gebruikslicentie. Geen maatwerkproject, maar vier vaste uitvoeringen. Wij leveren het raamwerk; u levert de collectie.
          </p>
          <div class="pl-hero__ctas">
            <a href="#tiers" class="tla-btn tla-btn--sage">Bekijk de uitvoeringen</a>
            <a href="/contact/nl/" class="tla-btn tla-btn--outline">Prijsopgave aanvragen</a>
          </div>
        </div>
        <div class="pl-hero__visual tla-fade tla-d1">
          <div class="ts-pricecard">
            <span class="ts-label">E&eacute;n station, excl. btw</span>
            <ul class="ts-pricecard__rows">
              {tiers.map((t) => (
                <li>
                  <span set:html={`${t.name} &middot; ${t.size.split("&middot;")[0].trim()}`} />
                  <strong set:html={t.totalEx} />
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Wat wij verkopen ───────────────────────────── -->
    <section class="ts-section ts-section--white" id="split">
      <div class="tla-container">
        <div class="tla-section-header tla-fade">
          <span class="tla-overline">De commerci&euml;le vorm</span>
