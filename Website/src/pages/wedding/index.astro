---
import "../../styles/wedding.css";
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>RSVP — Bruiloft Daan &amp; Thirza · 10.10.2026</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=UnifrakturMaguntia&family=Cinzel:wght@400;500;600&family=Crimson+Pro:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet" />
  </head>

  <body class="p-page">
    <main class="p-scroll" role="main">

      <span class="p-corner p-corner--tl" aria-hidden="true">&#10022;</span>
      <span class="p-corner p-corner--tr" aria-hidden="true">&#10022;</span>
      <span class="p-corner p-corner--bl" aria-hidden="true">&#10022;</span>
      <span class="p-corner p-corner--br" aria-hidden="true">&#10022;</span>

      <!-- ── Header ── -->
      <header class="p-header">
        <div class="p-seal" aria-hidden="true">
          <img src="/images/wedding/logo.png" alt="" />
        </div>
        <h1 class="p-title">Bruiloft Daan &amp; Thirza</h1>
        <p class="p-sub">10 oktober 2026 &middot; De Matehoeve &middot; Werkhoven</p>
      </header>

      <div class="p-div" aria-hidden="true"><span>&#9670;</span></div>

      <!-- ── Form ── -->
      <div id="theForm">

        <!-- E-mail (for confirmation only) -->
        <div>
          <label class="p-email-lbl" for="submitterEmail">
            Jouw e-mailadres &mdash; voor de bevestiging
          </label>
          <input
            type="email"
            id="submitterEmail"
            class="p-inp"
            placeholder="jouw@email.nl"
            autocomplete="email"
          />
        </div>

        <div class="p-div" aria-hidden="true"><span>&#9670;</span></div>

        <!-- Q1 · Voor wie? -->
        <div>
          <p class="p-q__title">Voor wie wordt dit ingevuld?</p>
          <div class="p-guests" id="guestList"></div>
          <button class="p-btn p-btn--outline p-btn--sm" id="addGuestBtn" type="button">
            + Gast toevoegen
          </button>
        </div>

        <div class="p-div" aria-hidden="true"><span>&#9670;</span></div>

        <!-- Q2 · Kom je? -->
        <div>
          <p class="p-q__title">Kom je?</p>
          <div class="p-att-rows" id="attSection"></div>
        </div>

        <div class="p-div" aria-hidden="true"><span>&#9670;</span></div>

        <!-- Q3 · Eet je mee? -->
        <div>
          <p class="p-q__title">Eet je mee?</p>
          <p class="p-q__hint">Eten start om 17:30</p>
          <div id="dinnerSection"></div>
        </div>

        <div class="p-div" aria-hidden="true"><span>&#9670;</span></div>

        <!-- Q4 · Dieet / Allergieën -->
        <div>
          <p class="p-q__title">Dieet / Allergi&euml;n?</p>
          <div class="p-text-rows" id="dietarySection"></div>
        </div>

        <div class="p-div" aria-hidden="true"><span>&#9670;</span></div>

        <!-- Q5 · Blijf je slapen? -->
        <div>
          <p class="p-q__title">Blijf je slapen?</p>
          <p class="p-q__hint">
            Tent of hooiloze zolder &middot; neem eigen spullen mee &middot; checkout 11:00
          </p>
          <div id="sleepingSection"></div>
        </div>

        <div class="p-div" aria-hidden="true"><span>&#9670;</span></div>

        <!-- Q6 · Extra opmerkingen -->
        <div>
          <p class="p-q__title">Extra opmerkingen?</p>
          <div class="p-text-rows" id="notesSection"></div>
        </div>

        <div class="p-div" aria-hidden="true"><span>&#9670;</span></div>

        <!-- Submit -->
        <div class="p-submit-area">
          <span class="p-error" id="formError" role="alert" aria-live="polite"></span>
          <button class="p-btn p-btn--dark p-btn--full" id="submitBtn" type="button">
            Versturen &#10022;
          </button>
        </div>

      </div><!-- /theForm -->

      <!-- ── Success ── -->
      <div class="p-success" id="formSuccess" aria-live="polite">
        <div class="p-success__orn" aria-hidden="true">&#10022;</div>
        <h2>Aanmelding ontvangen!</h2>
        <p>
          Top! We hebben jullie antwoorden ontvangen en sturen een bevestiging naar jouw e-mailadres.
          Tot 10 oktober!
        </p>
      </div>

      <div class="p-div" aria-hidden="true"><span>&#9670;</span></div>
      <footer class="p-foot">
        <p>Bruiloft Daan &amp; Thirza &middot; 10 &middot; 10 &middot; 2026 &middot; De Matehoeve</p>
      </footer>

    </main>

    <script>
      const API = 'https://api.weddingcambox.nl';

      // ── State ───────────────────────────────────────────────
      let guests = [{
        id: 0, name: '', attending: null, attending_other: '',
        dinner: null, sleeping: null, dietary: '', notes: ''
      }];
      let nextId = 1;

      function esc(s) {
        return String(s ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
      }

      function syncState() {
        guests.forEach(g => {
          const ne = document.getElementById(`gname-${g.id}`);             if (ne) g.name = ne.value;
          const ac = document.querySelector(`input[name="att-${g.id}"]:checked`); if (ac) g.attending = ac.value;
          const ao = document.getElementById(`att-other-${g.id}`);         if (ao) g.attending_other = ao.value;
          const dc = document.querySelector(`input[name="din-${g.id}"]:checked`); if (dc) g.dinner = dc.value;
          const sc = document.querySelector(`input[name="slp-${g.id}"]:checked`); if (sc) g.sleeping = sc.value;
          const di = document.getElementById(`dietary-${g.id}`);           if (di) g.dietary = di.value;
          const no = document.getElementById(`notes-${g.id}`);             if (no) g.notes = no.value;
        });
      }

      function updateNameLabels(id) {
        const inp = document.getElementById(`gname-${id}`);
        if (!inp) return;
        const g = guests.find(g => g.id === id);
        if (g) g.name = inp.value;
        const display = inp.value.trim() || `Gast ${guests.indexOf(g) + 1}`;
        document.querySelectorAll(`[data-gn="${id}"]`).forEach(el => { el.textContent = display; });
      }

      // ── Renders ─────────────────────────────────────────────
      function renderGuests() {
        document.getElementById('guestList').innerHTML = guests.map((g, i) => `
          <div class="p-guest-row" id="grow-${g.id}">
            <span class="p-guest-lbl">${i === 0 ? 'Jij' : `Gast ${i + 1}`}</span>
            <input
              type="text" id="gname-${g.id}" class="p-inp"
              placeholder="${i === 0 ? 'Jouw naam' : 'Naam'}"
              value="${esc(g.name)}"
              autocomplete="${i === 0 ? 'name' : 'off'}"
              oninput="updateNameLabels(${g.id})"
            />
            ${guests.length > 1
              ? `<button class="p-btn p-btn--rm" type="button" onclick="removeGuest(${g.id})" aria-label="Verwijder gast">&times;</button>`
              : ''}
          </div>
        `).join('');
      }

      function renderAttending() {
        document.getElementById('attSection').innerHTML = guests.map((g, i) => {
          const label   = esc(g.name.trim() || `Gast ${i + 1}`);
          const isOther = g.attending === 'other';
          return `
            <div class="p-att-row">
              <span class="p-att-name" data-gn="${g.id}">${label}</span>
              <div class="p-pills">
                <label class="p-pill">
                  <input type="radio" name="att-${g.id}" value="yes"${g.attending === 'yes' ? ' checked' : ''} />
                  <span class="p-pill__lbl">Ja</span>
                </label>
                <label class="p-pill">
                  <input type="radio" name="att-${g.id}" value="no"${g.attending === 'no' ? ' checked' : ''} />
                  <span class="p-pill__lbl">Nee</span>
                </label>
                <label class="p-pill">
                  <input type="radio" name="att-${g.id}" value="other"${isOther ? ' checked' : ''} />
                  <span class="p-pill__lbl">Anders&hellip;</span>
                </label>
              </div>
              <input
                type="text" id="att-other-${g.id}" class="p-inp p-anders-inp"
                placeholder="wat houdt je tegen?"
                value="${esc(g.attending_other)}"
                style="${isOther ? '' : 'display:none'}"
              />
            </div>
          `;
        }).join('');
        guests.forEach(g => {
          document.querySelectorAll(`input[name="att-${g.id}"]`).forEach(r => {
            r.addEventListener('change', () => {
              const el = document.getElementById(`att-other-${g.id}`);
              if (el) el.style.display = r.value === 'other' ? '' : 'none';
            });
          });
        });
      }

      function renderTable(cid, field) {
        document.getElementById(cid).innerHTML = `
          <div class="p-table">
            <div class="p-table__head">
              <span></span><span class="p-th">Ja</span><span class="p-th">Nee</span>
            </div>
            ${guests.map((g, i) => {
              const label = esc(g.name.trim() || `Gast ${i + 1}`);
              const val   = g[field];
              return `
                <div class="p-table__row">
                  <span class="p-td-name" data-gn="${g.id}">${label}</span>
                  <label class="p-td">
                    <input type="radio" name="${field}-${g.id}" value="yes"${val === 'yes' ? ' checked' : ''} />
                    <span class="p-rdot"></span>
                  </label>
                  <label class="p-td">
                    <input type="radio" name="${field}-${g.id}" value="no"${val === 'no' ? ' checked' : ''} />
                    <span class="p-rdot"></span>
                  </label>
                </div>
              `;
            }).join('')}
          </div>
        `;
      }

      function renderTextInputs(cid, field, placeholder) {
        document.getElementById(cid).innerHTML = guests.map((g, i) => {
          const label = esc(g.name.trim() || `Gast ${i + 1}`);
          return `
            <div class="p-text-row">
              <label class="p-text-row__name" for="${field}-${g.id}" data-gn="${g.id}">${label}</label>
              <input type="text" id="${field}-${g.id}" class="p-inp"
                placeholder="${esc(placeholder)}" value="${esc(g[field] || '')}" />
            </div>
          `;
        }).join('');
      }

      function renderNotes() {
        document.getElementById('notesSection').innerHTML = guests.map((g, i) => {
          const label = esc(g.name.trim() || `Gast ${i + 1}`);
          return `
            <div class="p-text-row p-text-row--area">
              <label class="p-text-row__name" for="notes-${g.id}" data-gn="${g.id}">${label}</label>
              <textarea id="notes-${g.id}" class="p-inp p-area" rows="2"
                placeholder="bijv. vragen, idee&euml;n&hellip;">${esc(g.notes || '')}</textarea>
            </div>
          `;
        }).join('');
      }

      function renderAll() {
        renderGuests();
        renderAttending();
        renderTable('dinnerSection',   'dinner');
        renderTextInputs('dietarySection', 'dietary', 'bijv. noten, gluten, lactose…');
        renderTable('sleepingSection', 'sleeping');
        renderNotes();
      }

      // ── Guest management ────────────────────────────────────
      function addGuest() {
        syncState();
        guests.push({ id: nextId++, name: '', attending: null, attending_other: '', dinner: null, sleeping: null, dietary: '', notes: '' });
        renderAll();
        const inp = document.getElementById(`gname-${guests[guests.length - 1].id}`);
        if (inp) inp.focus();
      }

      function removeGuest(id) {
        syncState();
        guests = guests.filter(g => g.id !== id);
        renderAll();
      }

      window.addGuest         = addGuest;
      window.removeGuest      = removeGuest;
      window.updateNameLabels = updateNameLabels;

      document.getElementById('addGuestBtn').addEventListener('click', addGuest);

      // ── Submit ──────────────────────────────────────────────
      document.getElementById('submitBtn').addEventListener('click', async () => {
        syncState();
        const email = document.getElementById('submitterEmail').value.trim();
        const errEl = document.getElementById('formError');
        errEl.textContent = '';

        if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
          errEl.textContent = 'Vul een geldig e-mailadres in.';
          document.getElementById('submitterEmail').focus();
          return;
        }
        const filled = guests.filter(g => g.name.trim());
        if (!filled.length) { errEl.textContent = 'Vul minimaal één naam in.'; return; }
        const noAtt = filled.filter(g => !g.attending);
        if (noAtt.length) {
          errEl.textContent = `Geef voor alle gasten aan of ze komen (${noAtt.map(g => g.name.trim()).join(', ')}).`;
          return;
        }

        const btn = document.getElementById('submitBtn');
        btn.disabled = true; btn.textContent = 'Versturen…';

        try {
          const res = await fetch(`${API}/api/wedding/rsvp`, {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              email,
              guests: filled.map(g => ({
                name:            g.name.trim(),
                attending:       g.attending,
                attending_other: g.attending === 'other' ? (g.attending_other || null) : null,
                dinner:          g.dinner   === 'yes' ? true : g.dinner   === 'no' ? false : null,
                sleeping:        g.sleeping === 'yes' ? true : g.sleeping === 'no' ? false : null,
                dietary:         g.dietary  || null,
                notes:           g.notes    || null,
              })),
            }),
          });
          if (!res.ok) throw new Error();
          document.getElementById('theForm').classList.add('hidden');
          const suc = document.getElementById('formSuccess');
          suc.classList.add('visible');
          suc.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } catch (_) {
          errEl.textContent = 'Er ging iets mis. Probeer het opnieuw.';
          btn.disabled = false; btn.textContent = 'Versturen ✦';
        }
      });

      renderAll();
    </script>
  </body>
</html>
