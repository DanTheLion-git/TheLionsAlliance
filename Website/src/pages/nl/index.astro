---
import "../../styles/homepage.css";
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>The Lions Alliance &mdash; Museale en erfgoedverhalen door technologie</title>
    <meta name="description" content="The Lions Alliance ontwikkelt technologie die verhalen vertelt voor musea en erfgoedlocaties &mdash; touchtafels, sprekende portretten en wandelquests, gemaakt voor kleinere, zelfstandige locaties." />
    <link rel="icon" type="image/png" href="/favicon-logo.png" />
    <link rel="alternate" hreflang="en" href="https://thelionsalliance.com/" />
    <link rel="alternate" hreflang="nl" href="https://thelionsalliance.com/nl/" />
    <link rel="alternate" hreflang="x-default" href="https://thelionsalliance.com/" />
  </head>
  <body class="tla-page">

    <!-- ── Navigatie ──────────────────────────────────── -->
    <nav class="tla-nav" id="tla-nav">
      <div class="tla-nav__inner">
        <a href="/nl/" class="tla-nav__logo"><img src="/images/branding/lions-logo.webp" alt="" class="tla-nav__logo-img" />The Lions <span>Alliance</span></a>
        <ul class="tla-nav__links">
          <li><a href="#studio">Studio</a></li>
          <li><a href="#pillars">Ons werk</a></li>
          <li><a href="#roadmap">Roadmap</a></li>
        </ul>
        <div class="tla-nav__actions">
          <a href="/" class="tla-nav__lang" hreflang="en" lang="en" title="View in English">EN</a>
          <a href="/contact/nl/" class="tla-nav__cta tla-nav__cta--gold">Contact</a>
        </div>
        <button class="tla-nav__hamburger" id="tla-hamburger" aria-label="Menu">
          <span></span><span></span><span></span>
        </button>
      </div>
      <div class="tla-nav__mobile" id="tla-mobile-menu">
        <a href="#studio">Studio</a>
        <a href="#pillars">Ons werk</a>
        <a href="#roadmap">Roadmap</a>
        <a href="/contact/nl/">Contact</a>
        <a href="/" hreflang="en" lang="en">View in English</a>
      </div>
    </nav>

    <!-- ── Hero ───────────────────────────────────────── -->
    <section class="tla-hero" id="hero">
      <img src="/images/branding/lions-mark.svg" alt="" class="tla-hero__watermark" aria-hidden="true" />
      <div class="tla-container">
        <div class="tla-fade">
          <p class="tla-hero__eyebrow">Studio voor museale technologie &amp; erfgoed</p>
        </div>
        <h1 class="tla-hero__title tla-fade tla-d1">Wij maken museale verhalen<br /><em>tot ervaringen die bijblijven.</em></h1>
        <p class="tla-hero__subtitle tla-fade tla-d2">Wij bouwen de technologie waarmee kleinere, zelfstandige musea en erfgoedlocaties hun verhaal op een nieuwe manier kunnen vertellen &mdash; touchtafels, sprekende portretten en wandelquests, gemaakt voor de locatie, niet andersom.</p>
        <div class="tla-hero__actions tla-fade tla-d3">
          <a href="#pillars" class="tla-btn tla-btn--primary">Bekijk ons werk</a>
          <a href="#roadmap" class="tla-btn tla-btn--outline">Onze roadmap</a>
        </div>
      </div>
    </section>

    <!-- ── Over de studio ─────────────────────────────── -->
    <section class="tla-studio" id="studio">
      <div class="tla-container">
        <div class="tla-studio__grid">
          <div class="tla-studio__text tla-fade">
            <span class="tla-overline">Over de studio</span>
            <h2>Waar technologie het verhaal dient</h2>
            <p>The Lions Alliance is een creatieve studio met &eacute;&eacute;n specialisme: musea en erfgoedlocaties de technologie geven om hun eigen verhaal te vertellen, zonder een groot corporate productiebudget. Wij bouwen touchtafels, sprekende-portret-installaties en fysieke wandelquests &mdash; altijd ontworpen rond een specifieke plek, een specifiek archief, een specifiek verhaal.</p>
            <p style="margin-top:1rem;">De studio wordt gerund door <strong>Dani&euml;l</strong> en <strong>Thirza van Leeuwen</strong>.</p>
          </div>
          <div class="tla-studio__phases tla-fade tla-d2">
            <div class="tla-phase-item">
              <span class="tla-phase-item__num">01</span>
              <div>
                <p class="tla-phase-item__label">Gemaakt voor</p>
                <p class="tla-phase-item__name">Kleinere, zelfstandige musea &amp; erfgoedlocaties</p>
              </div>
            </div>
            <div class="tla-phase-item">
              <span class="tla-phase-item__num">02</span>
              <div>
                <p class="tla-phase-item__label">Aangedreven door</p>
                <p class="tla-phase-item__name">Touchscreens, AI-stem &amp; 3D-animatie, fysieke rekwisieten</p>
              </div>
            </div>
            <div class="tla-phase-item">
              <span class="tla-phase-item__num">03</span>
              <div>
                <p class="tla-phase-item__label">Altijd</p>
                <p class="tla-phase-item__name">Eerst het verhaal, dan de techniek</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Ons werk ───────────────────────────────────── -->
    <section class="tla-pillars" id="pillars">
      <div class="tla-container">
        <div class="tla-section-header tla-fade">
          <span class="tla-overline">Vlaggenschipprojecten</span>
          <h2>Museale technologie, gebouwd en in ontwikkeling</h2>
          <div class="tla-divider"></div>
        </div>
      </div>
      <div class="tla-pillars__grid-wrap">
        <div class="tla-pillars__grid">
          <!-- Medelotapps & Touchtafels -->
          <div class="tla-pillar-card tla-fade tla-d1">
            <img src="/images/touch-tafel/IMG20260920161431.webp" alt="Een op maat gebouwde Medelotapps-touchtafel bij Museum Medelo in Meijel" loading="lazy" style="width:100%; aspect-ratio:4/3; object-fit:cover; border-radius:var(--tla-radius-md); margin-bottom:20px;" />
            <div class="tla-pillar-card__head">
              <span class="tla-pillar-card__num">01</span>
              <span class="tla-badge tla-badge--live">Live bij Museum Medelo</span>
            </div>
            <h3>Medelotapps &amp; Touchtafels</h3>
            <p class="tla-pillar-card__tagline">Kiosksoftware &middot; Touchtafels op maat &middot; Museumklaar</p>
            <p class="tla-pillar-card__desc">Ons WPF-touchkiosk-platform is af en draait vandaag al op twee machines bij Museum Medelo &mdash; een touchtafel en een klassenbord &mdash; en werd live getoond aan het publiek tijdens de ledenopening van het museum op 20 september 2026. De software staat klaar; de inhoud wordt op maat gebouwd voor het eigen archief en verhaal van elke locatie.</p>
            <a href="/touchscreens/nl/" class="tla-btn tla-btn--outline tla-btn--sm" style="margin-top:auto;">Bekijk Touch Station</a>
          </div>
          <!-- Brief aan Jan Truijen -->
          <div class="tla-pillar-card tla-fade tla-d2">
            <img src="/images/brief-aan-jan/prototype-20-09-2026/IMG20260920135209.webp" alt="De installatie Brief aan Jan Truijen opgesteld bij Museum Medelo, met typemachine en antiek bureau" loading="lazy" style="width:100%; aspect-ratio:4/3; object-fit:cover; border-radius:var(--tla-radius-md); margin-bottom:20px;" />
            <div class="tla-pillar-card__head">
              <span class="tla-pillar-card__num">02</span>
              <span class="tla-badge tla-badge--dev">Werkend prototype</span>
            </div>
            <h3>Brief aan Jan Truijen</h3>
            <p class="tla-pillar-card__tagline">Sprekend portret &middot; AI-stem &amp; 3D-animatie &middot; Gebouwd om te reizen</p>
            <p class="tla-pillar-card__desc">Bezoekers schrijven een brief op een omgebouwde antieke typemachine &mdash; en een historisch portret schrijft terug, in karakter, met een AI-stem en 3D-gezichtsanimatie. Live getoond tijdens de opening van Museum Medelo op 20 september 2026, en vanaf de eerste dag ontworpen om aan te passen voor een nieuw portret, een nieuwe locatie.</p>
            <a href="/jan-truijen/nl/" class="tla-btn tla-btn--outline tla-btn--sm" style="margin-top:auto;">Bekijk de installatie</a>
          </div>
          <!-- Puzzle Quests — Skeleton Key -->
          <div class="tla-pillar-card tla-fade tla-d3">
            <img src="/images/puzzle-quests/skeleton-key-wip/IMG20260901145952.webp" alt="De echte, handgemaakte Skeleton Key voor de wandelroute van Puzzle Quests, een koperen sleutel met leeuwenkop" loading="lazy" style="width:100%; aspect-ratio:4/3; object-fit:cover; border-radius:var(--tla-radius-md); margin-bottom:20px;" />
            <div class="tla-pillar-card__head">
              <span class="tla-pillar-card__num">03</span>
              <span class="tla-badge tla-badge--dev">In bouw &amp; test</span>
            </div>
            <h3>Puzzle Quests &mdash; Skeleton Key</h3>
            <p class="tla-pillar-card__tagline">Wandelroute &middot; Fysiek rekwisiet &middot; Geen app, geen scherm</p>
            <p class="tla-pillar-card__desc">Een wandelquest van 5 km door Meijel, met een handgemaakte koperen sleutel die acht verborgen slotstations aanvoelt. Hardware en route staan; we zitten nu in de bouw- en testfase, in aanloop naar de eerste proefwandeling met echte bezoekers.</p>
            <a href="/puzzlequests/nl/" class="tla-btn tla-btn--outline tla-btn--sm" style="margin-top:auto;">Bekijk Puzzle Quests</a>
          </div>
          <!-- Immersive Worlds — VRVoyage -->
          <div class="tla-pillar-card tla-fade tla-d3">
            <img src="/images/immersive-worlds/Preview_1.png" alt="360&deg; VR-still uit VRVoyage — een boot vaart onder een brug door in 17e-eeuws Amsterdam" loading="lazy" style="width:100%; aspect-ratio:4/3; object-fit:cover; border-radius:var(--tla-radius-md); margin-bottom:20px;" />
            <div class="tla-pillar-card__head">
              <span class="tla-pillar-card__num">04</span>
              <span class="tla-badge tla-badge--live">Nu live</span>
            </div>
            <h3>Immersive Worlds</h3>
            <p class="tla-pillar-card__tagline">360&deg; VR &middot; Live in Amsterdam &middot; VRVoyage</p>
            <p class="tla-pillar-card__desc">VRVoyage, onze 70 minuten durende 360&deg; VR-reis door de Gouden Eeuw van Amsterdam, is al een live toeristische attractie &mdash; het bewijs dat onze plaatsgebonden verhalen ook op stadsschaal werken. Een nieuw proof of concept in Unreal Engine laat zien wat hierna mogelijk is.</p>
            <a href="/immersive/nl/" class="tla-btn tla-btn--outline tla-btn--sm" style="margin-top:auto;">Bekijk Immersive Worlds</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Ook nog actief ─────────────────────────────── -->
    <section class="tla-featured">
      <div class="tla-container">
        <div class="tla-section-header tla-fade">
          <span class="tla-overline">Ook nog actief</span>
          <h2>Twee andere studioproducten, rustig doorlopend</h2>
          <div class="tla-divider"></div>
        </div>
        <p class="tla-fade" style="max-width:620px; margin:0 auto 40px; text-align:center; color:var(--tla-text-body);">Naast ons museumwerk runnen wij twee lopende foto-producten voor evenementen &mdash; stabiel, zelfbediening, en nog steeds groeiend.</p>
        <div class="tla-fade" style="display:grid; grid-template-columns:repeat(2,1fr); gap:28px; max-width:760px; margin:0 auto;">
          <div class="tla-value-card">
            <h3>WeddingCamBox</h3>
            <p>Zelfbedienings-fotohokje voor bruiloften &mdash; nog altijd boekbaar.</p>
            <a href="https://weddingcambox.nl" target="_blank" rel="noopener" class="tla-btn tla-btn--outline tla-btn--sm" style="margin-top:16px;">Bezoek WeddingCamBox</a>
          </div>
          <div class="tla-value-card">
            <h3>ShutterShare</h3>
            <p>Hetzelfde idee, gebouwd voor zakelijke evenementen.</p>
            <a href="https://shuttershare.nl" target="_blank" rel="noopener" class="tla-btn tla-btn--outline tla-btn--sm" style="margin-top:16px;">Bezoek ShutterShare</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Roadmap ────────────────────────────────────── -->
    <section class="tla-roadmap" id="roadmap">
      <div class="tla-container">
        <div class="tla-section-header tla-fade">
          <span class="tla-overline">Waar we naartoe gaan</span>
          <h2>Onze roadmap</h2>
          <div class="tla-divider"></div>
        </div>
        <div class="tla-timeline tla-fade tla-d1">

          <!-- Nu – midden 2026 -->
          <div class="tla-timeline__item tla-timeline__item--active">
            <div class="tla-timeline__node"></div>
            <div class="tla-timeline__head">
              <h3>Nu &mdash; midden 2026</h3>
              <span class="tla-badge tla-badge--live">Actief</span>
            </div>
            <p class="tla-timeline__desc">Medelotapps live bij Museum Medelo (touchtafel + klassenbord) &middot; Skeleton Key in bouw &amp; test &middot; Touch Station-platform gelanceerd</p>
          </div>

          <!-- Eind 2026 -->
          <div class="tla-timeline__item tla-timeline__item--outlined">
            <div class="tla-timeline__node"></div>
            <div class="tla-timeline__head">
              <h3>Eind 2026</h3>
              <span class="tla-badge tla-badge--dev">Op komst</span>
            </div>
            <p class="tla-timeline__desc">Verdere inhoudsopbouw Museum Medelo &middot; eerste proefwandeling Skeleton Key met echte bezoekers &middot; Jan Truijen op weg naar een permanente installatie</p>
          </div>

          <!-- 2027 -->
          <div class="tla-timeline__item tla-timeline__item--outlined">
            <div class="tla-timeline__node"></div>
            <div class="tla-timeline__head">
              <h3>2027</h3>
              <span class="tla-badge tla-badge--future">In planning</span>
            </div>
            <p class="tla-timeline__desc">Jan Truijen-format aangeboden aan een tweede locatie &middot; Puzzle Quests: bouw van Living Chronicle &amp; Puzzle Lantern</p>
          </div>

          <!-- 2028+ -->
          <div class="tla-timeline__item tla-timeline__item--dashed">
            <div class="tla-timeline__node"></div>
            <div class="tla-timeline__head">
              <h3>2028 en verder</h3>
              <span class="tla-badge tla-badge--future">Toekomstvisie</span>
            </div>
            <p class="tla-timeline__desc">Opschaling van Immersive Worlds &middot; meer sprekend-portret-installaties bij Nederlandse erfgoedlocaties &middot; plaatsgebonden verhalen voor musea en historische locaties</p>
          </div>

        </div>
      </div>
    </section>

    <!-- ── Onze aanpak ────────────────────────────────── -->
    <section class="tla-values">
      <div class="tla-container">
        <div class="tla-section-header tla-fade">
          <span class="tla-overline">Onze aanpak</span>
          <h2>Waarom The Lions Alliance</h2>
          <div class="tla-divider"></div>
        </div>
        <div class="tla-values__grid">
          <div class="tla-value-card tla-fade tla-d1">
            <h3>Verhaal eerst</h3>
            <p>Elk project begint met het verhaal van een plek &mdash; een streeklegende, een historische figuur, een archief dat de meeste bezoekers nooit zien.</p>
          </div>
          <div class="tla-value-card tla-fade tla-d2">
            <h3>Fysiek en digitaal</h3>
            <p>Touchtafels, sprekende portretten, gedrukte puzzelobjecten &mdash; wij ontwerpen ervaringen die bezoekers kunnen vastpakken en ontdekken, niet alleen bekijken.</p>
          </div>
          <div class="tla-value-card tla-fade tla-d3">
            <h3>Gebouwd voor de locatie</h3>
            <p>Geen kant-en-klaar platform. Elke touchtafel, elk portret en elke quest wordt ontworpen en gebouwd rond &eacute;&eacute;n specifieke locatie en haar verhaal.</p>
          </div>
          <div class="tla-value-card tla-fade tla-d1">
            <h3>Gemaakt om te onthouden</h3>
            <p>Onze maatstaf voor succes is eenvoudig: bleef de ervaring iemand bij nadat ze weer naar buiten liepen?</p>
          </div>
          <div class="tla-value-card tla-fade tla-d2">
            <h3>Van &eacute;&eacute;n object tot een stadsbrede route</h3>
            <p>Dezelfde manier van denken werkt voor een sprekend portret &eacute;n voor een meeslepende, stadsbrede ervaring.</p>
          </div>
          <div class="tla-value-card tla-fade tla-d3">
            <h3>Partners voor de lange termijn</h3>
            <p>Wij bouwen duurzame relaties op met musea, heemkundeverenigingen en zelfstandige locaties &mdash; geen losse opdrachten.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ── Contact ────────────────────────────────────── -->
    <section class="tla-contact" id="contact">
      <div class="tla-container">
        <span class="tla-overline tla-fade">Neem contact op</span>
        <h2 class="tla-fade tla-d1">Laten we samen iets bouwen<br />dat de moeite waard is om te onthouden</h2>
        <p class="tla-fade tla-d2">Of u nu een museum of erfgoedlocatie vertegenwoordigt en nieuwsgierig bent naar touchscreens, een sprekend portret of een wandelquest, of gewoon een samenwerking wilt verkennen &mdash; we horen graag van u.</p>
        <div class="tla-contact__actions tla-fade tla-d3">
          <a href="/contact/nl/" class="tla-btn tla-btn--gold">Stuur ons een bericht</a>
          <a href="#pillars" class="tla-btn tla-btn--ghost">Bekijk ons werk</a>
        </div>
        <p class="tla-contact__email tla-fade tla-d3"><a href="mailto:hello@thelionsalliance.com">hello@thelionsalliance.com</a></p>
      </div>
    </section>

    <!-- ── Footer ─────────────────────────────────────── -->
    <footer class="tla-footer">
      <div class="tla-container">
        <div class="tla-footer__inner">
          <div class="tla-footer__brand">
            <div class="tla-footer__brand-row">
              <img src="/images/branding/lions-logo.webp" alt="" class="tla-footer__logo-img" />
              <span class="tla-footer__logo">The Lions <span>Alliance</span></span>
            </div>
            <span class="tla-footer__tagline">Een creatieve ervaringsstudio</span>
          </div>
          <nav class="tla-footer__links">
            <a href="#studio">Studio</a>
            <a href="#pillars">Ons werk</a>
            <a href="#roadmap">Roadmap</a>
            <a href="/contact/nl/">Contact</a>
            <a href="/jan-truijen/nl/">Brief aan Jan Truijen</a>
            <a href="/immersive/nl/">Immersive Worlds</a>
            <a href="/puzzlequests/nl/">Puzzle Quests</a>
            <a href="/touchscreens/nl/">Touch Station</a>
            <a href="/" hreflang="en" lang="en">English version</a>
          </nav>
        </div>
        <p class="tla-footer__copy">&copy; {year} The Lions Alliance. Alle rechten voorbehouden.</p>
      </div>
    </footer>

    <!-- ── Scripts ─────────────────────────────────────── -->
    <script>
      const nav = document.getElementById('tla-nav');
      window.addEventListener('scroll', () => {
        nav.classList.toggle('scrolled', window.scrollY > 40);
      }, { passive: true });

      const hamburger = document.getElementById('tla-hamburger');
      const mobileMenu = document.getElementById('tla-mobile-menu');
      hamburger.addEventListener('click', () => {
        hamburger.classList.toggle('active');
        mobileMenu.classList.toggle('open');
      });

      mobileMenu.querySelectorAll('a').forEach(link => {
        link.addEventListener('click', () => {
          hamburger.classList.remove('active');
          mobileMenu.classList.remove('open');
        });
      });

      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', (e) => {
          const target = document.querySelector(anchor.getAttribute('href'));
          if (target) {
            e.preventDefault();
            target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        });
      });

      const faders = document.querySelectorAll('.tla-fade');
      const fadeObserver = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            entry.target.classList.add('tla-visible');
            fadeObserver.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
      faders.forEach(el => fadeObserver.observe(el));
    </script>
  </body>
</html>
