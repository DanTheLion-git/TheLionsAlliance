---
import "../../styles/hall.css";
import HallHead from "../../components/hall/HallHead.astro";
import Nav from "../../components/hall/Nav.astro";
import Footer from "../../components/hall/Footer.astro";
const year = new Date().getFullYear();
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contact | The Lions Alliance</title>
    <meta name="description" content="Get in touch with The Lions Alliance about museum partnerships, Touch Station, Puzzle Quests, wedding photo bookings or anything else." />
    <link rel="icon" type="image/png" href="/favicon-logo.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" hreflang="en" href="https://thelionsalliance.com/contact/" />
    <link rel="alternate" hreflang="nl" href="https://thelionsalliance.com/contact/nl/" />
    <link rel="alternate" hreflang="x-default" href="https://thelionsalliance.com/contact/" />
    <HallHead />
  </head>
  <body class="tla-page">

    <!-- ── Navigation ─────────────────────────────────── -->
    <Nav lang="en" alt="/contact/nl/" />

    <main id="main">

    <!-- ── Contact Page ───────────────────────────────── -->
    <section class="tla-contactpage">
      <div class="tla-container tla-contactpage__inner">
        <header class="tla-contactpage__intro tla-fade">
          <h1>Write to us</h1>
          <p>
            Tell us about your museum, your event or your idea: a touch table, a talking portrait, a walking quest, a wedding photo booth, or something we haven&rsquo;t built yet. We reply within one or two working days.
          </p>
          <p class="tla-contactpage__direct">
            You can also reach us directly at <a href="mailto:hello@thelionsalliance.com">hello@thelionsalliance.com</a>.
          </p>
        </header>

        <div class="tla-contactpage__card tla-fade tla-d1">
          <form class="tla-form" id="contactForm" novalidate>
            <div class="tla-form__row">
              <div class="tla-form__group">
                <label for="cName">Your name</label>
                <input type="text" id="cName" name="name" autocomplete="name" placeholder="e.g. Anna van der Meer" required />
                <span class="tla-form__error" id="nameError"></span>
              </div>
              <div class="tla-form__group">
                <label for="cEmail">Email address</label>
                <input type="email" id="cEmail" name="email" autocomplete="email" placeholder="anna@example.com" required />
                <span class="tla-form__error" id="emailError"></span>
              </div>
            </div>

            <div class="tla-form__group">
              <label for="cTopic">What&rsquo;s your question about?</label>
              <select id="cTopic" name="topic">
                <option value="Touch Station / Medelotapps">Touch Station: touchscreens for your museum</option>
                <option value="Puzzle Quests — museum / heritage venue">Puzzle Quests: museum or heritage venue</option>
                <option value="WeddingCamBox / ShutterShare booking">WeddingCamBox or ShutterShare booking</option>
                <option value="Studio collaboration / partnership">Studio collaboration or partnership</option>
                <option value="Brief aan Jan Truijen">Brief aan Jan Truijen: talking portrait</option>
                <option value="Immersive Worlds">Immersive Worlds</option>
                <option value="Press / media">Press or media</option>
                <option value="General question">General question</option>
                <option value="Other">Something else</option>
              </select>
            </div>

            <div class="tla-form__group">
              <label for="cMessage">Your message</label>
              <textarea id="cMessage" name="message" rows="6" placeholder="Tell us what you have in mind&hellip;" required></textarea>
              <span class="tla-form__error" id="msgError"></span>
            </div>

            <button type="submit" class="tla-btn tla-btn--full" id="submitBtn">Send message</button>
          </form>

          <div class="tla-form__success" id="formSuccess">
            <div class="tla-form__success-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="square" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg></div>
            <h2>Message sent</h2>
            <p>Thank you for reaching out. We&rsquo;ll get back to you within one or two business days. A confirmation has been sent to your email.</p>
            <a href="/" class="tla-form__success-link">Back to the studio</a>
          </div>
        </div>

        <aside class="tla-contactpage__aside tla-fade tla-d2">
          <h3>Other ways to reach us</h3>
          <ul class="tla-contactpage__channels">
            <li>
              <span class="tla-contactpage__channel-label">Studio email</span>
              <a href="mailto:hello@thelionsalliance.com">hello@thelionsalliance.com</a>
            </li>
            <li>
              <span class="tla-contactpage__channel-label">WeddingCamBox bookings</span>
              <a href="https://weddingcambox.nl" target="_blank" rel="noopener">weddingcambox.nl</a>
            </li>
            <li>
              <span class="tla-contactpage__channel-label">ShutterShare events</span>
              <a href="https://shuttershare.nl" target="_blank" rel="noopener">shuttershare.nl</a>
            </li>
            <li>
              <span class="tla-contactpage__channel-label">Puzzle Quests &middot; pilot venue</span>
              <span class="tla-contactpage__channel-text">Museum Medelo, Tomveld 2, Meijel</span>
            </li>
          </ul>
        </aside>
      </div>
    </section>

    <!-- ── Footer ─────────────────────────────────────── -->
    </main>

    <Footer lang="en" />

    <script>
      const API_URL = 'https://api.weddingcambox.nl';

      const form = document.getElementById('contactForm');
      if (form) {
        form.addEventListener('submit', async (e) => {
          e.preventDefault();

          const nameEl  = document.getElementById('cName');
          const emailEl = document.getElementById('cEmail');
          const topicEl = document.getElementById('cTopic');
          const msgEl   = document.getElementById('cMessage');
          const btn     = document.getElementById('submitBtn');

          const name    = nameEl.value.trim();
          const email   = emailEl.value.trim();
          const topic   = topicEl.value;
          const message = msgEl.value.trim();

          // Clear prior errors
          document.getElementById('nameError').textContent  = '';
          document.getElementById('emailError').textContent = '';
          document.getElementById('msgError').textContent   = '';

          let valid = true;
          if (!name) {
            document.getElementById('nameError').textContent = 'Please enter your name.';
            valid = false;
          }
          if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
            document.getElementById('emailError').textContent = 'Please enter a valid email address.';
            valid = false;
          }
          if (!message) {
            document.getElementById('msgError').textContent = 'Please write a message.';
            valid = false;
          }
          if (!valid) return;

          btn.disabled    = true;
          btn.textContent = 'Sending…';

          try {
            const res = await fetch(`${API_URL}/api/tla/contact`, {
              method:  'POST',
              headers: { 'Content-Type': 'application/json' },
              body:    JSON.stringify({ name, email, topic, message }),
            });
            if (!res.ok) throw new Error('Server error');
            form.classList.add('hidden');
            document.getElementById('formSuccess').classList.add('visible');
            window.scrollTo({ top: 0, behavior: 'smooth' });
          } catch (err) {
            btn.disabled    = false;
            btn.textContent = 'Send message';
            document.getElementById('msgError').textContent =
              'Something went wrong. Please try again or email us directly at hello@thelionsalliance.com.';
          }
        });
      }
    </script>
  </body>
</html>
